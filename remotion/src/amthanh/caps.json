[
 [
  {
   "text": "*Chớp* và *sấm* xảy",
   "start": 0.3,
   "end": 1.216
  },
  {
   "text": "ra cùng một lúc,",
   "start": 1.216,
   "end": 2.022
  },
  {
   "text": "vậy vì sao ta",
   "start": 2.022,
   "end": 3.218
  },
  {
   "text": "lại thấy chớp trước",
   "start": 3.218,
   "end": 4.024
  },
  {
   "text": "rồi mới nghe sấm?",
   "start": 4.024,
   "end": 5.15
  }
 ],
 [
  {
   "text": "Nhưng điều lạ hơn",
   "start": 0.45,
   "end": 1.397
  },
  {
   "text": "là *khoảng* *chờ* ấy",
   "start": 1.397,
   "end": 2.443
  },
  {
   "text": "cho ta biết",
   "start": 2.443,
   "end": 3.153
  },
  {
   "text": "cơn giông đang *cách*",
   "start": 3.153,
   "end": 4.21
  },
  {
   "text": "*mình* *bao* *xa*.",
   "start": 4.21,
   "end": 5.04
  }
 ],
 [
  {
   "text": "Hóa ra *ánh* *sáng*",
   "start": 0.4,
   "end": 1.417
  },
  {
   "text": "đến mắt ta gần",
   "start": 1.417,
   "end": 2.353
  },
  {
   "text": "như tức thì,",
   "start": 2.353,
   "end": 2.988
  },
  {
   "text": "còn *âm* *thanh* đi",
   "start": 2.988,
   "end": 4.105
  },
  {
   "text": "chậm hơn nhiều.",
   "start": 4.105,
   "end": 4.86
  }
 ],
 [
  {
   "text": "Vậy muốn tính",
   "start": 0.39,
   "end": 0.995
  },
  {
   "text": "được khoảng cách,",
   "start": 0.995,
   "end": 1.601
  },
  {
   "text": "trước hết ta phải",
   "start": 1.601,
   "end": 3.088
  },
  {
   "text": "biết âm thanh *đi*",
   "start": 3.088,
   "end": 3.895
  },
  {
   "text": "*nhanh* *bao* *nhiêu*.",
   "start": 3.895,
   "end": 4.62
  }
 ],
 [
  {
   "text": "Ở thế kỷ *17*,",
   "start": 0.44,
   "end": 2.054
  },
  {
   "text": "nhà khoa học người",
   "start": 2.054,
   "end": 2.788
  },
  {
   "text": "Pháp Ga-xen-đi đã tìm",
   "start": 2.788,
   "end": 3.522
  },
  {
   "text": "ra điều đó bằng",
   "start": 3.522,
   "end": 4.356
  },
  {
   "text": "một *khẩu* *đại* *bác*.",
   "start": 4.356,
   "end": 5.34
  }
 ],
 [
  {
   "text": "Vì thế ông đứng",
   "start": 0.34,
   "end": 1.395
  },
  {
   "text": "thật xa khẩu súng,",
   "start": 1.395,
   "end": 2.361
  },
  {
   "text": "rồi *bấm* *giờ* từ",
   "start": 2.361,
   "end": 3.416
  },
  {
   "text": "lúc thấy *lửa*",
   "start": 3.416,
   "end": 4.14
  },
  {
   "text": "*lóe* *lên* đến lúc",
   "start": 4.14,
   "end": 5.366
  },
  {
   "text": "nghe *tiếng* *nổ*.",
   "start": 5.366,
   "end": 6.21
  }
 ],
 [
  {
   "text": "*Ánh* *sáng* tới",
   "start": 0.51,
   "end": 1.104
  },
  {
   "text": "mắt gần như",
   "start": 1.104,
   "end": 1.698
