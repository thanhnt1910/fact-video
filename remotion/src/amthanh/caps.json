  {
   "text": "ngay lập tức,",
   "start": 1.698,
   "end": 2.292
  },
  {
   "text": "nên khoảng chờ ấy",
   "start": 2.292,
   "end": 3.384
  },
  {
   "text": "chính là *thời* *gian*",
   "start": 3.384,
   "end": 4.176
  },
  {
   "text": "âm thanh đi.",
   "start": 4.176,
   "end": 4.89
  }
 ],
 [
  {
   "text": "Giống như thấy",
   "start": 0.39,
   "end": 1.02
  },
  {
   "text": "người thợ *bổ* *củi*",
   "start": 1.02,
   "end": 1.86
  },
  {
   "text": "bên kia sông:",
   "start": 1.86,
   "end": 2.77
  },
  {
   "text": "rìu đã bổ xuống,",
   "start": 2.77,
   "end": 3.61
  },
  {
   "text": "một lúc sau mới",
   "start": 3.61,
   "end": 4.63
  },
  {
   "text": "nghe *tiếng* *cốp*.",
   "start": 4.63,
   "end": 5.38
  }
 ],
 [
  {
   "text": "Từ đó có công",
   "start": 0.38,
   "end": 1.231
  },
  {
   "text": "thức rất gọn:",
   "start": 1.231,
   "end": 2.319
  },
  {
   "text": "*tốc* *độ* = *quãng*",
   "start": 2.319,
   "end": 3.339
  },
  {
   "text": "*đường* *÷* *thời* *gian*.",
   "start": 3.339,
   "end": 4.45
  }
 ],
 [
  {
   "text": "*Giả* *sử* khẩu súng",
   "start": 0.34,
   "end": 1.306
  },
  {
   "text": "cách *3* *km*,",
   "start": 1.306,
   "end": 2.031
  },
  {
   "text": "và ông đếm",
   "start": 2.031,
   "end": 3.085
  },
  {
   "text": "được *9* *giây*.",
   "start": 3.085,
   "end": 4.09
  }
 ],
 [
  {
   "text": "*3* *000* *÷*",
   "start": 0.4,
   "end": 1.909
  },
  {
   "text": "*9* = khoảng *333*",
   "start": 1.909,
   "end": 3.882
  },
  {
   "text": "mét mỗi giây.",
   "start": 3.882,
   "end": 4.61
  }
 ],
 [
  {
   "text": "Nhưng số đo",
   "start": 0.38,
   "end": 1.113
  },
  {
   "text": "của Ga-xen-đi *còn* *cao*",
   "start": 1.113,
   "end": 2.091
  },
  {
   "text": "*hơn* thực tế,",
   "start": 2.091,
   "end": 2.824
  },
  {
   "text": "vì cách *bấm* *giờ*",
   "start": 2.824,
   "end": 4.112
  },
  {
   "text": "thời ấy còn thô.",
   "start": 4.112,
   "end": 5.21
  }
 ],
 [
  {
   "text": "Đến năm *1738*,",
   "start": 0.36,
   "end": 2.29
  },
  {
   "text": "Viện Hàn lâm Khoa",
   "start": 2.29,
   "end": 3.268
  },
  {
   "text": "học Pháp *đo* *lại*",
   "start": 3.268,
   "end": 4.217
  },
  {
   "text": "thật cẩn thận.",
   "start": 4.217,
   "end": 4.98
  }
 ],
 [
  {
   "text": "Kết quả là",
   "start": 0.37,
   "end": 1.019
  },
  {
   "text": "họ ra *332*",
   "start": 1.019,
   "end": 2.535
  },
  {
   "text": "mét mỗi giây,",
   "start": 2.535,
   "end": 3.184
  },
  {
   "text": "rất gần với *số*",
   "start": 3.184,
   "end": 4.44
  },
  {
   "text": "*đo* *ngày* *nay*.",
   "start": 4.44,
   "end": 5.21
  }
 ],
 [
  {
   "text": "Vậy ngày nay,",
   "start": 0.37,
   "end": 1.039
  },
  {
   "text": "ở *20* *°C*,",
