   "start": 1.203,
   "end": 2.325
  },
  {
   "text": "cơn giông cách",
   "start": 2.325,
   "end": 3.568
  },
  {
   "text": "bạn chừng đó.",
   "start": 3.568,
   "end": 4.62
  }
 ],
 [
  {
   "text": "Vậy chớp và sấm",
   "start": 0.29,
   "end": 1.508
  },
  {
   "text": "cùng xảy ra,",
   "start": 1.508,
   "end": 2.242
  },
  {
   "text": "nhưng *âm* *thanh*",
   "start": 2.242,
   "end": 2.975
  },
  {
   "text": "*đi* *chậm* *hơn*",
   "start": 2.975,
   "end": 3.708
  },
  {
   "text": "*ánh* *sáng* nên ta",
   "start": 3.708,
   "end": 4.906
  },
  {
   "text": "nghe sấm sau.",
   "start": 4.906,
   "end": 5.76
  }
 ],
 [
  {
   "text": "Và chính *khoảng* *chờ*",
   "start": 0.36,
   "end": 1.301
  },
  {
   "text": "ấy cho ta biết",
   "start": 1.301,
   "end": 2.363
  },
  {
   "text": "cơn giông còn *xa*",
   "start": 2.363,
   "end": 3.304
  },
  {
   "text": "hay đã *gần*.",
   "start": 3.304,
   "end": 4.13
  }
 ]
]