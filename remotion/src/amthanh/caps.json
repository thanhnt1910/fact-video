   "end": 2.684
  },
  {
   "text": "âm thanh đi khoảng",
   "start": 2.684,
   "end": 3.576
  },
  {
   "text": "*343* mét mỗi giây.",
   "start": 3.576,
   "end": 5.48
  }
 ],
 [
  {
   "text": "Còn ở *0* *°C*,",
   "start": 0.5,
   "end": 1.436
  },
  {
   "text": "âm thanh *chậm* *lại*,",
   "start": 1.436,
   "end": 2.641
  },
  {
   "text": "chỉ còn *331*",
   "start": 2.641,
   "end": 4.608
  },
  {
   "text": "mét mỗi giây.",
   "start": 4.608,
   "end": 5.43
  }
 ],
 [
  {
   "text": "Giờ quay",
   "start": 0.37,
   "end": 0.771
  },
  {
   "text": "lại cơn giông:",
   "start": 0.771,
   "end": 1.374
  },
  {
   "text": "trong *3* *giây*,",
   "start": 1.374,
   "end": 2.326
  },
  {
   "text": "âm thanh đi",
   "start": 2.326,
   "end": 3.178
  },
  {
   "text": "được *bao* *xa*?",
   "start": 3.178,
   "end": 3.9
  }
 ],
 [
  {
   "text": "*343* *×* *3* =",
   "start": 0.48,
   "end": 1.905
  },
  {
   "text": "gần *1* *000* mét.",
   "start": 1.905,
   "end": 4.03
  }
 ],
 [
  {
   "text": "Số ấy *gần*",
   "start": 0.41,
   "end": 1.1
  },
  {
   "text": "*bằng* *1* *km*,",
   "start": 1.1,
   "end": 1.79
  },
  {
   "text": "nên cứ *3*",
   "start": 1.79,
   "end": 2.76
  },
  {
   "text": "*giây* chờ là",
   "start": 2.76,
   "end": 3.61
  },
  {
   "text": "cơn giông xa thêm",
   "start": 3.61,
   "end": 4.53
  },
  {
   "text": "chừng *1* *km*.",
   "start": 4.53,
   "end": 5.34
  }
 ],
 [
  {
   "text": "*Ví* *dụ*,",
   "start": 0.33,
   "end": 0.933
  },
  {
   "text": "bạn thấy chớp",
   "start": 0.933,
   "end": 1.793
  },
  {
   "text": "rồi đếm đến *9*",
   "start": 1.793,
   "end": 2.82
  },
  {
   "text": "mới nghe sấm.",
   "start": 2.82,
   "end": 3.71
  }
 ],
 [
  {
   "text": "*9* *÷* *3*",
   "start": 0.36,
