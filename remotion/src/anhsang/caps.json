[
 [
  {
   "text": "Nếu *Mặt* *Trời* *tắt*",
   "start": 0.39,
   "end": 1.294
  },
  {
   "text": "ngay bây giờ,",
   "start": 1.294,
   "end": 2.131
  },
  {
   "text": "bạn vẫn thấy",
   "start": 2.131,
   "end": 2.809
  },
  {
   "text": "nó *sáng* *thêm* hơn",
   "start": 2.809,
   "end": 3.712
  },
  {
   "text": "*8* *phút* nữa.",
   "start": 3.712,
   "end": 4.51
  }
 ],
 [
  {
   "text": "Vì ánh sáng *không*",
   "start": 0.4,
   "end": 1.433
  },
  {
   "text": "*đến* *tức* *thì*,",
   "start": 1.433,
   "end": 2.548
  },
  {
   "text": "nó phải đi và",
   "start": 2.548,
   "end": 3.582
  },
  {
   "text": "*mất* *thời* *gian*.",
   "start": 3.582,
   "end": 4.947
  },
  {
   "text": "Nhưng nó nhanh",
   "start": 4.947,
   "end": 5.952
  },
  {
   "text": "đến mức bật đèn",
   "start": 5.952,
   "end": 7.325
  },
  {
   "text": "là *sáng* *ngay*.",
   "start": 7.325,
   "end": 8.22
  }
 ],
 [
  {
   "text": "Người đầu tiên *chứng*",
   "start": 0.35,
   "end": 1.148
  },
  {
   "text": "*minh* điều ngược",
   "start": 1.148,
   "end": 1.747
  },
  {
   "text": "lại không dùng thước",
   "start": 1.747,
   "end": 2.755
  },
  {
   "text": "hay đồng hồ,",
   "start": 2.755,
   "end": 3.354
  },
  {
   "text": "mà dùng *một* *mặt*",
   "start": 3.354,
   "end": 4.522
  },
  {
   "text": "*trăng* của *sao* *Mộc*.",
   "start": 4.522,
   "end": 5.55
  }
 ],
 [
  {
   "text": "Năm *1638*,",
   "start": 0.38,
   "end": 2.0
  },
  {
   "text": "nhà bác học *Galileo*",
   "start": 2.0,
   "end": 3.52
  },
  {
   "text": "mô tả trong sách",
   "start": 3.52,
   "end": 4.4
  },
  {
   "text": "một *cách* *thử*.",
   "start": 4.4,
   "end": 5.18
  }
 ],
 [
  {
   "text": "Hai người,",
   "start": 0.37,
   "end": 0.836
  },
  {
   "text": "mỗi người cầm",
   "start": 0.836,
   "end": 1.816
  },
  {
   "text": "*một* *đèn* *lồng*,",
   "start": 1.816,
   "end": 2.805
  },
  {
   "text": "đứng cách nhau chưa",
   "start": 2.805,
   "end": 3.737
  },
  {
   "text": "đầy *2* *ki-lô-mét*.",
   "start": 3.737,
   "end": 4.89
  }
 ],
 [
  {
   "text": "Người thứ",
   "start": 0.35,
   "end": 0.886
  },
  {
   "text": "nhất *mở* *đèn*.",
   "start": 0.886,
   "end": 2.101
  },
  {
   "text": "Người thứ hai",
   "start": 2.101,
   "end": 3.055
  },
  {
   "text": "vừa thấy thì *mở*",
   "start": 3.055,
   "end": 4.248
  },
  {
   "text": "*đèn* *của* *mình*.",
   "start": 4.248,
   "end": 5.803
  },
  {
   "text": "Người thứ nhất xem",
   "start": 5.803,
   "end": 7.015
  },
  {
   "text": "*chờ* *bao* *lâu*.",
   "start": 7.015,
   "end": 7.94
  }
 ],
 [
  {
   "text": "Kết quả:",
   "start": 0.49,
   "end": 0.923
  },
  {
   "text": "Galileo *không* *phân*",
   "start": 0.923,
   "end": 2.165
  },
  {
   "text": "*biệt* *được* có độ",
   "start": 2.165,
   "end": 3.03
  },
  {
   "text": "trễ hay không.",
   "start": 3.03,
   "end": 4.03
  },
  {
   "text": "Ông viết:",
   "start": 4.03,
   "end": 4.462
  },
  {
   "text": "nếu không tức",
   "start": 4.462,
   "end": 5.362
  },
  {
   "text": "thì thì cũng",
   "start": 5.362,
   "end": 6.121
  },
  {
   "text": "*nhanh* *vô* *cùng*.",
   "start": 6.121,
   "end": 6.89
  }
 ],
 [
  {
   "text": "Dễ hiểu thôi:",
   "start": 0.43,
   "end": 1.1
  },
  {
   "text": "ánh sáng chạy hết",
   "start": 1.1,
   "end": 2.212
  },
  {
   "text": "quãng đó chỉ trong",
   "start": 2.212,
   "end": 3.375
  },
  {
   "text": "*5* *phần* *triệu* *giây*,",
   "start": 3.375,
   "end": 5.384
  },
  {
   "text": "còn tay người *chậm*",
   "start": 5.384,
   "end": 6.977
  },
  {
   "text": "*hơn* *hàng* *nghìn* *lần*.",
   "start": 6.977,
   "end": 7.99
  }
 ],
 [
  {
   "text": "Muốn thấy độ trễ,",
   "start": 0.42,
   "end": 1.246
  },
  {
   "text": "phải cho ánh",
   "start": 1.246,
   "end": 2.045
  },
  {
   "text": "sáng đi *xa*",
   "start": 2.045,
   "end": 2.664
  },
  {
   "text": "*hơn* *rất* *nhiều*.",
   "start": 2.664,
   "end": 3.284
  },
  {
   "text": "Năm *1672*,",
   "start": 3.284,
   "end": 6.364
  },
  {
   "text": "nhà thiên văn",
   "start": 6.364,
   "end": 6.984
  },
  {
   "text": "trẻ người Đan Mạch",
   "start": 6.984,
   "end": 7.999
  },
  {
   "text": "*Ole* *Rømer* đến",
   "start": 7.999,
   "end": 8.619
  },
  {
   "text": "làm việc ở *Đài*",
   "start": 8.619,
   "end": 9.444
  },
  {
   "text": "*thiên* *văn* *Paris*.",
   "start": 9.444,
   "end": 10.39
  }
 ],
 [
  {
   "text": "Ở đó người ta",
   "start": 0.32,
   "end": 1.329
  },
  {
   "text": "theo dõi *Io*,",
   "start": 1.329,
   "end": 1.987
  },
  {
   "text": "một mặt trăng",
   "start": 1.987,
   "end": 2.946
  },
  {
   "text": "của *sao* *Mộc*.",
   "start": 2.946,
   "end": 3.605
  },
  {
   "text": "Cứ *42* *tiếng* *rưỡi*,",
   "start": 3.605,
   "end": 6.642
  },
  {
   "text": "Io quay",
   "start": 6.642,
   "end": 7.081
  },
  {
   "text": "trọn *một* *vòng*.",
   "start": 7.081,
   "end": 7.86
  }
 ],
 [
  {
   "text": "Mỗi vòng,",
   "start": 0.39,
   "end": 0.87
  },
  {
   "text": "Io *chui* *vào*",
   "start": 0.87,
   "end": 1.81
  },
  {
   "text": "*bóng* sao Mộc",
   "start": 1.81,
   "end": 2.53
  },
  {
   "text": "rồi *ló* *ra*.",
   "start": 2.53,
   "end": 3.54
  },
  {
   "text": "Như một *chiếc* *đồng*",
   "start": 3.54,
   "end": 5.03
  },
  {
   "text": "*hồ* ngoài vũ trụ,",
   "start": 5.03,
   "end": 5.99
  },
  {
   "text": "mỗi lần ló ra",
   "start": 5.99,
   "end": 7.26
  },
  {
   "text": "là một nhịp.",
   "start": 7.26,
   "end": 8.32
  }
 ],
 [
  {
   "text": "Rømer thấy điều lạ.",
   "start": 0.46,
   "end": 1.665
  },
  {
   "text": "Trái Đất *đi*",
   "start": 1.665,
   "end": 2.969
  },
  {
   "text": "*xa* sao Mộc,",
   "start": 2.969,
   "end": 3.872
  },
  {
   "text": "Io ló",
   "start": 3.872,
   "end": 4.475
  },
  {
   "text": "ra *càng* *muộn*.",
   "start": 4.475,
   "end": 5.379
  },
  {
   "text": "Trái Đất *lại* *gần*,",
   "start": 5.379,
   "end": 7.084
  },
  {
   "text": "Io ló",
   "start": 7.084,
   "end": 7.986
  },
  {
   "text": "ra *sớm* *hơn*.",
   "start": 7.986,
   "end": 9.01
  }
 ],
 [
  {
   "text": "Mỗi vòng chỉ",
   "start": 0.34,
   "end": 1.019
  },
  {
   "text": "lệch *chút* *xíu*,",
   "start": 1.019,
   "end": 1.697
  },
  {
   "text": "không thấy được.",
   "start": 1.697,
   "end": 2.616
  },
  {
   "text": "Nhưng gộp *40*",
   "start": 2.616,
   "end": 4.217
  },
  {
   "text": "*vòng* lại thì độ",
   "start": 4.217,
   "end": 5.371
  },
  {
   "text": "lệch *hiện* *rõ*.",
   "start": 5.371,
   "end": 6.17
  }
 ],
 [
  {
   "text": "Ông hiểu ra:",
   "start": 0.36,
   "end": 1.6
  },
  {
   "text": "Io *vẫn* *quay* *đều*.",
   "start": 1.6,
   "end": 3.063
  },
  {
   "text": "Chỉ là ánh",
   "start": 3.063,
   "end": 3.943
  },
  {
   "text": "sáng phải đi *quãng*",
   "start": 3.943,
   "end": 5.337
  },
  {
   "text": "*đường* *dài* *hơn*,",
   "start": 5.337,
   "end": 6.217
  },
  {
   "text": "nên *tới* *muộn* *hơn*.",
   "start": 6.217,
   "end": 7.73
  }
 ],
 [
  {
   "text": "Giống thư gửi",
   "start": 0.39,
   "end": 1.118
  },
  {
   "text": "*đều* *mỗi* *ngày*:",
   "start": 1.118,
   "end": 1.845
  },
  {
   "text": "đường dài ra thì",
   "start": 1.845,
   "end": 3.235
  },
  {
   "text": "thư *đến* *muộn* *dần*,",
   "start": 3.235,
   "end": 4.415
  },
  {
   "text": "dù người gửi",
   "start": 4.415,
   "end": 5.422
  },
  {
   "text": "*vẫn* *đúng* *giờ*.",
   "start": 5.422,
   "end": 6.27
  }
 ],
 [
  {
   "text": "Ngày *9/11/1676*,",
   "start": 0.39,
   "end": 1.699
  },
  {
   "text": "Io ló ra *muộn*",
   "start": 1.699,
   "end": 2.572
  },
  {
   "text": "*10* *phút* so",
   "start": 2.572,
   "end": 4.429
  },
  {
   "text": "với bảng giờ tính",
   "start": 4.429,
   "end": 5.302
  },
  {
   "text": "từ tháng 8,",
   "start": 5.302,
   "end": 6.939
  },
  {
   "text": "như Rømer",
   "start": 6.939,
   "end": 7.565
  },
  {
   "text": "*đã* *báo* *trước*.",
   "start": 7.565,
   "end": 8.34
  }
 ],
 [
  {
   "text": "Từ đó ông ước",
   "start": 0.54,
   "end": 1.307
  },
  {
   "text": "tính ánh sáng cần",
   "start": 1.307,
   "end": 2.234
  },
  {
   "text": "khoảng *22* *phút* để",
   "start": 2.234,
   "end": 5.066
  },
  {
   "text": "đi hết *đường* *kính*",
   "start": 5.066,
   "end": 5.833
  },
  {
   "text": "*quỹ* *đạo* Trái Đất.",
   "start": 5.833,
   "end": 6.72
  }
 ],
 [
  {
   "text": "Không phải",
   "start": 0.38,
   "end": 0.875
  },
  {
   "text": "ai cũng tin.",
   "start": 0.875,
   "end": 1.957
  },
  {
   "text": "Giám đốc đài",
   "start": 1.957,
   "end": 2.699
  },
  {
   "text": "*Cassini* phản đối,",
   "start": 2.699,
   "end": 3.936
  },
  {
   "text": "vì hiện tượng",
   "start": 3.936,
   "end": 4.928
  },
  {
   "text": "*không* *thấy* ở các",
   "start": 4.928,
   "end": 5.918
  },
  {
   "text": "mặt trăng khác.",
   "start": 5.918,
   "end": 6.87
  }
 ],
 [
  {
   "text": "Năm *1729*,",
   "start": 0.45,
   "end": 2.953
  },
  {
   "text": "*James* *Bradley* dùng cách",
   "start": 2.953,
   "end": 4.497
  },
  {
   "text": "đo *hoàn* *toàn* *khác*",
   "start": 4.497,
   "end": 5.407
  },
  {
   "text": "và cũng thấy",
   "start": 5.407,
   "end": 6.089
  },
  {
   "text": "ánh sáng *có* *tốc*",
   "start": 6.089,
   "end": 6.998
  },
  {
   "text": "*độ* *hữu* *hạn*.",
   "start": 6.998,
   "end": 7.8
  }
 ],
 [
  {
   "text": "Giờ chỉ còn",
   "start": 0.4,
   "end": 1.118
  },
  {
   "text": "*một* *phép* *chia*:",
   "start": 1.118,
   "end": 2.296
  },
  {
   "text": "tốc độ = *quãng*",
   "start": 2.296,
   "end": 3.363
  },
  {
   "text": "*đường* *÷* *thời* *gian*.",
   "start": 3.363,
   "end": 4.44
  }
 ],
 [
  {
   "text": "Quãng đường:",
   "start": 0.43,
   "end": 0.853
  },
  {
   "text": "khoảng *300* *triệu* *km*.",
   "start": 0.853,
   "end": 3.124
  },
  {
   "text": "Thời gian:",
   "start": 3.124,
   "end": 3.547
  },
  {
   "text": "*22* *phút*,",
   "start": 3.547,
   "end": 5.495
  },
  {
   "text": "tức *1* *320* *giây*.",
   "start": 5.495,
   "end": 8.76
  }
 ],
 [
  {
   "text": "*300* *triệu* ÷ *1*",
   "start": 0.39,
   "end": 2.606
  },
  {
   "text": "*320* ≈ *227* *nghìn*",
   "start": 2.606,
   "end": 5.121
  },
  {
   "text": "ki-lô-mét mỗi giây.",
   "start": 5.121,
   "end": 5.98
  }
 ],
 [
  {
   "text": "Hơi thấp,",
   "start": 0.35,
   "end": 0.791
  },
  {
   "text": "vì ánh sáng",
   "start": 0.791,
   "end": 1.872
  },
  {
   "text": "thực ra chỉ mất",
   "start": 1.872,
   "end": 2.753
  },
  {
   "text": "*gần* *17* *phút*.",
   "start": 2.753,
   "end": 4.565
  },
  {
   "text": "Với thời gian đúng,",
   "start": 4.565,
   "end": 5.637
  },
  {
   "text": "ra *khoảng* *300* *nghìn*",
   "start": 5.637,
   "end": 7.179
  },
  {
   "text": "km mỗi giây.",
   "start": 7.179,
   "end": 7.96
  }
 ],
 [
  {
   "text": "Mỗi giây,",
   "start": 0.38,
   "end": 0.832
  },
  {
   "text": "ánh sáng chạy",
   "start": 0.832,
   "end": 1.611
  },
  {
   "text": "*quanh* *Trái* *Đất*",
   "start": 1.611,
   "end": 2.289
  },
  {
   "text": "*7* *vòng* *rưỡi*.",
   "start": 2.289,
   "end": 3.63
  }
 ],
 [
  {
   "text": "Năm *1849*,",
   "start": 0.35,
   "end": 1.9
  },
  {
   "text": "nhà vật lý",
   "start": 1.9,
   "end": 2.804
  },
  {
   "text": "Pháp *Hippolyte* *Fizeau*",
   "start": 2.804,
   "end": 4.893
  },
  {
   "text": "đo ánh sáng *ngay*",
   "start": 4.893,
   "end": 5.869
  },
  {
   "text": "*trên* *mặt* *đất*,",
   "start": 5.869,
   "end": 6.533
  },
  {
   "text": "không cần",
   "start": 6.533,
   "end": 7.306
  },
  {
   "text": "nhờ bầu trời.",
   "start": 7.306,
   "end": 8.09
  }
 ],
 [
  {
   "text": "Hai kính thiên",
   "start": 0.41,
   "end": 1.151
  },
  {
   "text": "văn cách nhau",
   "start": 1.151,
   "end": 1.892
  },
  {
   "text": "*hơn* *8,6* *km*,",
   "start": 1.892,
   "end": 2.88
  },
  {
   "text": "ở *Suresnes* và",
   "start": 2.88,
   "end": 4.225
  },
  {
   "text": "trên đồi *Montmartre*.",
   "start": 4.225,
   "end": 5.72
  }
 ],
 [
  {
   "text": "Giữa đường ánh",
   "start": 0.55,
   "end": 1.201
  },
  {
   "text": "sáng là *bánh* *xe*",
   "start": 1.201,
   "end": 2.35
  },
  {
   "text": "*720* *răng* *cưa*.",
   "start": 2.35,
   "end": 6.002
  },
  {
   "text": "Ánh sáng",
   "start": 6.002,
   "end": 6.436
  },
  {
   "text": "chui qua *khe*,",
   "start": 6.436,
   "end": 7.297
  },
  {
   "text": "tới gương xa",
   "start": 7.297,
   "end": 7.949
  },
  {
   "text": "rồi *dội* *về*.",
   "start": 7.949,
   "end": 8.96
  }
 ],
 [
  {
   "text": "Bánh xe",
   "start": 0.48,
   "end": 0.971
  },
  {
   "text": "*quay* *nhanh* *dần*.",
   "start": 0.971,
   "end": 2.048
  },
  {
   "text": "Đến một tốc độ,",
   "start": 2.048,
   "end": 3.241
  },
  {
   "text": "ánh sáng dội",
   "start": 3.241,
   "end": 4.108
  },
  {
   "text": "về gặp *răng* *kế*",
   "start": 4.108,
   "end": 5.09
  },
  {
   "text": "*bên* *chắn* *lại*,",
   "start": 5.09,
   "end": 6.147
  },
  {
