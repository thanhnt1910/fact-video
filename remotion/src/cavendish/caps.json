[
 [
  {
   "text": "Cân một quả",
   "start": 0.44,
   "end": 1.119
  },
  {
   "text": "táo thì dễ.",
   "start": 1.119,
   "end": 1.709
  },
  {
   "text": "Nhưng làm sao *cân*",
   "start": 1.709,
   "end": 2.894
  },
  {
   "text": "*được* *cả* *Trái* *Đất*?",
   "start": 2.894,
   "end": 3.8
  }
 ],
 [
  {
   "text": "Không có chiếc cân",
   "start": 0.27,
   "end": 1.094
  },
  {
   "text": "nào *đủ* *lớn*,",
   "start": 1.094,
   "end": 1.711
  },
  {
   "text": "và cũng không",
   "start": 1.711,
   "end": 2.669
  },
  {
   "text": "ai *nhấc* *nổi* một",
   "start": 2.669,
   "end": 3.582
  },
  {
   "text": "hành tinh lên.",
   "start": 3.582,
   "end": 4.32
  }
 ],
 [
  {
   "text": "Năm *1774*,",
   "start": 0.37,
   "end": 0.872
  },
  {
   "text": "nhà thiên văn *Nevil*",
   "start": 0.872,
   "end": 2.456
  },
  {
   "text": "*Maskelyne* mang một *sợi*",
   "start": 2.456,
   "end": 4.501
  },
  {
   "text": "*dây* *dọi* lên chân",
   "start": 4.501,
   "end": 5.504
  },
  {
   "text": "núi Schiehallion ở Scotland.",
   "start": 5.504,
   "end": 7.61
  }
 ],
 [
  {
   "text": "Dây dọi là sợi",
   "start": 0.29,
   "end": 1.403
  },
  {
   "text": "dây treo *một* *quả*",
   "start": 1.403,
   "end": 2.215
  },
  {
   "text": "*nặng* ở đầu,",
   "start": 2.215,
   "end": 3.135
  },
  {
   "text": "nên lúc nào cũng",
   "start": 3.135,
   "end": 3.947
  },
  {
   "text": "*chỉ* *thẳng* *xuống* *đất*.",
   "start": 3.947,
   "end": 4.88
  }
 ],
 [
  {
   "text": "Ngọn núi đứng",
   "start": 0.53,
   "end": 1.188
  },
  {
   "text": "bên cạnh *cũng*",
   "start": 1.188,
   "end": 1.847
  },
  {
   "text": "*hút* quả nặng,",
   "start": 1.847,
   "end": 2.505
  },
  {
   "text": "nên sợi dây",
   "start": 2.505,
   "end": 3.463
  },
  {
   "text": "bị *lệch* đi",
   "start": 3.463,
   "end": 4.122
  },
  {
   "text": "một chút xíu.",
   "start": 4.122,
   "end": 5.06
  }
 ],
 [
  {
   "text": "So *lực* *hút* *của*",
   "start": 0.44,
   "end": 1.192
  },
  {
   "text": "*núi* với *lực* *hút*",
   "start": 1.192,
   "end": 2.044
  },
  {
   "text": "*của* *cả* *Trái* *Đất*,",
   "start": 2.044,
   "end": 2.906
  },
  {
   "text": "người ta tính",
   "start": 2.906,
   "end": 3.78
  },
  {
   "text": "được Trái Đất",
   "start": 3.78,
   "end": 4.344
  },
  {
   "text": "nặng gấp ngọn núi",
   "start": 4.344,
   "end": 5.096
  },
  {
   "text": "*bao* *nhiêu* *lần*.",
   "start": 5.096,
   "end": 5.87
  }
 ],
 [
  {
   "text": "Nhưng *không* *ai* *biết*",
   "start": 0.47,
   "end": 1.476
  },
  {
   "text": "bên trong núi là",
   "start": 1.476,
   "end": 2.352
  },
  {
   "text": "loại đá nào,",
   "start": 2.352,
   "end": 3.2
  },
  {
   "text": "nặng hay nhẹ,",
   "start": 3.2,
   "end": 3.857
  },
  {
   "text": "nên con số chỉ",
   "start": 3.857,
   "end": 5.083
  },
  {
   "text": "là *ước* *chừng*.",
   "start": 5.083,
   "end": 5.86
  }
 ],
 [
  {
   "text": "Kết quả ra *thấp*",
   "start": 0.41,
   "end": 1.382
  },
  {
   "text": "*hơn* *thật* khoảng *1/5*.",
   "start": 1.382,
   "end": 3.21
  }
 ],
 [
  {
   "text": "Cách tốt hơn",
   "start": 0.44,
   "end": 1.205
  },
  {
   "text": "là *mang* *ngọn* *núi*",
   "start": 1.205,
   "end": 2.065
  },
  {
   "text": "*vào* *trong* *phòng*,",
   "start": 2.065,
   "end": 3.21
  },
  {
   "text": "bằng những *quả* *chì*",
   "start": 3.21,
   "end": 4.07
  },
  {
   "text": "mà mình cân được.",
   "start": 4.07,
   "end": 5.05
  }
 ],
 [
  {
   "text": "Ý tưởng này của",
   "start": 0.35,
   "end": 1.045
  },
  {
   "text": "mục sư *John* *Michell*,",
   "start": 1.045,
   "end": 1.914
  },
  {
   "text": "nhưng ông *mất* trước",
   "start": 1.914,
   "end": 2.979
  },
  {
   "text": "khi kịp làm.",
   "start": 2.979,
   "end": 3.62
  }
 ],
 [
  {
   "text": "Người làm tiếp",
   "start": 0.44,
   "end": 1.129
  },
  {
   "text": "là *Henry* *Cavendish*,",
   "start": 1.129,
   "end": 2.597
  },
  {
   "text": "một nhà khoa",
   "start": 2.597,
   "end": 3.285
  },
  {
   "text": "học nổi tiếng là",
   "start": 3.285,
   "end": 4.204
  },
  {
   "text": "*sống* *ẩn* *dật*,",
   "start": 4.204,
   "end": 5.033
  },
  {
   "text": "vào năm *1797*.",
   "start": 5.033,
   "end": 6.76
  }
 ],
 [
  {
   "text": "Ông treo một",
   "start": 0.43,
   "end": 1.033
  },
  {
   "text": "*thanh* *gỗ* *dài* bằng",
   "start": 1.033,
   "end": 1.837
  },
  {
   "text": "sợi dây mảnh,",
   "start": 1.837,
   "end": 2.441
  },
  {
   "text": "*2* *đầu* thanh",
   "start": 2.441,
   "end": 3.494
  },
  {
   "text": "gắn *2* *quả*",
   "start": 3.494,
   "end": 4.097
  },
  {
   "text": "*cầu* *chì* *nhỏ*.",
   "start": 4.097,
   "end": 4.82
  }
 ],
 [
  {
   "text": "Rồi ông đặt",
   "start": 0.34,
   "end": 1.049
  },
  {
   "text": "gần chúng *2* *quả*",
   "start": 1.049,
   "end": 2.349
  },
  {
   "text": "*cầu* *chì* *lớn*,",
   "start": 2.349,
   "end": 3.298
  },
  {
   "text": "mỗi quả nặng",
   "start": 3.298,
   "end": 4.007
  },
  {
   "text": "hơn *150* *ki-lô-gam*.",
   "start": 4.007,
   "end": 5.19
  }
 ],
 [
  {
   "text": "Quả lớn *kéo* quả",
   "start": 0.37,
   "end": 1.261
  },
  {
   "text": "nhỏ về phía mình,",
   "start": 1.261,
   "end": 2.151
  },
  {
   "text": "làm *thanh* *gỗ* *xoay*",
   "start": 2.151,
   "end": 3.292
  },
  {
   "text": "đi một chút.",
   "start": 3.292,
   "end": 4.08
  }
 ],
 [
  {
   "text": "Lực kéo ấy nhỏ",
   "start": 0.37,
   "end": 1.247
  },
  {
   "text": "hơn sức nặng của",
   "start": 1.247,
   "end": 2.125
  },
  {
   "text": "chính quả cầu nhỏ",
   "start": 2.125,
   "end": 3.002
  },
  {
   "text": "*hàng* *chục* *triệu* *lần*.",
   "start": 3.002,
   "end": 4.0
  }
 ],
 [
  {
   "text": "Chỉ cần",
   "start": 0.21,
   "end": 0.842
  },
  {
   "text": "*một* *luồng* *gió*,",
   "start": 0.842,
   "end": 1.579
  },
  {
   "text": "hay *một* *bên* *hộp*",
   "start": 1.579,
   "end": 2.562
  },
  {
   "text": "*ấm* *hơn* bên kia,",
   "start": 2.562,
   "end": 3.546
  },
  {
   "text": "là thanh gỗ lắc",
   "start": 3.546,
   "end": 4.529
  },
  {
   "text": "theo gió chứ không",
   "start": 4.529,
   "end": 5.613
  },
  {
   "text": "theo quả chì.",
   "start": 5.613,
   "end": 6.47
  }
 ],
 [
  {
   "text": "Vì vậy Cavendish *nhốt*",
   "start": 0.37,
   "end": 1.767
  },
  {
   "text": "cả thiết bị trong",
   "start": 1.767,
   "end": 2.511
  },
  {
   "text": "*một* *căn* *nhà* *kín*,",
   "start": 2.511,
   "end": 3.555
  },
  {
   "text": "và đứng bên",
   "start": 3.555,
   "end": 4.113
  },
  {
   "text": "ngoài *nhìn* *qua*",
   "start": 4.113,
   "end": 4.802
  },
  {
   "text": "*kính* *thiên* *văn*.",
   "start": 4.802,
   "end": 5.48
  }
 ],
 [
  {
   "text": "Ông kéo dây để",
   "start": 0.46,
   "end": 1.414
  },
  {
   "text": "*đổi* *chỗ* quả cầu",
   "start": 1.414,
   "end": 2.247
  },
  {
   "text": "lớn sang bên kia,",
   "start": 2.247,
   "end": 3.651
  },
  {
   "text": "thanh gỗ lại",
   "start": 3.651,
   "end": 4.276
  },
  {
   "text": "*xoay* *ngược* *lại*,",
   "start": 4.276,
   "end": 5.281
  },
  {
   "text": "và ông *ghi* *lại*",
   "start": 5.281,
   "end": 6.115
  },
  {
   "text": "từng chút một.",
   "start": 6.115,
   "end": 6.86
  }
 ],
 [
  {
   "text": "Cùng một",
   "start": 0.47,
   "end": 0.861
  },
  {
   "text": "quả cầu nhỏ,",
   "start": 0.861,
   "end": 1.729
  },
  {
   "text": "một bên bị *Trái*",
   "start": 1.729,
   "end": 2.511
  },
  {
   "text": "*Đất* *kéo* *xuống* *đất*,",
   "start": 2.511,
   "end": 3.624
  },
  {
   "text": "một bên bị *quả*",
   "start": 3.624,
   "end": 4.407
  },
  {
   "text": "*chì* *kéo* *sang* *ngang*.",
   "start": 4.407,
   "end": 5.4
  }
 ],
 [
  {
   "text": "*So* *hai* *lực* *ấy*,",
   "start": 0.44,
   "end": 1.219
  },
  {
   "text": "biết quả chì",
   "start": 1.219,
   "end": 2.014
  },
  {
   "text": "nặng bao nhiêu,",
   "start": 2.014,
   "end": 2.598
  },
  {
   "text": "nằm cách bao xa,",
   "start": 2.598,
   "end": 3.608
  },
  {
   "text": "và Trái Đất",
   "start": 3.608,
   "end": 4.392
  },
  {
   "text": "to cỡ nào,",
   "start": 4.392,
   "end": 5.077
  },
  {
   "text": "là tính ra",
   "start": 5.077,
   "end": 6.061
  },
  {
   "text": "được *Trái* *Đất*",
   "start": 6.061,
   "end": 6.746
  },
  {
   "text": "*nặng* *bao* *nhiêu*.",
   "start": 6.746,
   "end": 7.45
  }
 ],
 [
  {
   "text": "Kết quả:",
   "start": 0.47,
   "end": 0.848
  },
  {
   "text": "Trái Đất nặng *gần*",
   "start": 0.848,
   "end": 1.873
  },
  {
   "text": "*5,5* *lần* so",
   "start": 1.873,
   "end": 2.628
  },
  {
   "text": "với một khối nước",
   "start": 2.628,
   "end": 3.524
  },
  {
   "text": "cùng kích thước.",
   "start": 3.524,
   "end": 4.31
  }
 ],
 [
  {
   "text": "Đá trên mặt đất",
   "start": 0.42,
   "end": 1.258
  },
  {
   "text": "*nhẹ* *hơn* thế nhiều,",
   "start": 1.258,
   "end": 2.096
  },
  {
   "text": "nên bên trong Trái",
   "start": 2.096,
   "end": 3.294
  },
  {
   "text": "Đất phải có *thứ*",
   "start": 3.294,
   "end": 4.132
  },
  {
   "text": "*gì* *đó* *rất* *nặng*.",
   "start": 4.132,
   "end": 5.09
  }
 ],
 [
  {
   "text": "Nhân lên cho",
   "start": 0.47,
   "end": 1.124
  },
  {
   "text": "cả quả cầu,",
   "start": 1.124,
   "end": 1.779
  },
  {
   "text": "Trái Đất nặng",
   "start": 1.779,
   "end": 2.713
  },
  {
   "text": "khoảng *6* *nghìn*",
   "start": 2.713,
   "end": 3.586
  },
  {
   "text": "*tỷ* *tỷ* *tấn*,",
   "start": 3.586,
   "end": 4.24
  },
  {
   "text": "mà số đo",
   "start": 4.24,
   "end": 4.895
  },
  {
   "text": "ngày nay chỉ lệch",
   "start": 4.895,
   "end": 5.877
  },
  {
   "text": "*chưa* *đến* *1%*.",
   "start": 5.877,
   "end": 6.87
  }
 ],
 [
  {
   "text": "Chỉ với",
   "start": 0.44,
   "end": 0.885
  },
  {
   "text": "*2* *quả* *chì*,",
   "start": 0.885,
   "end": 1.551
  },
  {
   "text": "một sợi dây và",
   "start": 1.551,
   "end": 2.7
  },
  {
   "text": "rất nhiều kiên nhẫn,",
   "start": 2.7,
   "end": 3.74
  },
  {
   "text": "Cavendish đã *cân* *được*",
   "start": 3.74,
   "end": 5.403
  },
  {
   "text": "*cả* *Trái* *Đất*.",
   "start": 5.403,
   "end": 6.31
  }
 ]
]