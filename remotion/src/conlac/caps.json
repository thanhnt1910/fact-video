[
 [
  {
   "text": "Đứng trên Trái Đất",
   "start": 0.44,
   "end": 1.653
  },
  {
   "text": "*chẳng* *thấy* *nó* *quay*,",
   "start": 1.653,
   "end": 3.277
  },
  {
   "text": "làm sao *chứng* *minh*?",
   "start": 3.277,
   "end": 4.61
  }
 ],
 [
  {
   "text": "Nhưng năm *1851*,",
   "start": 0.43,
   "end": 2.556
  },
  {
   "text": "*một* *quả* *nặng*",
   "start": 2.556,
   "end": 3.148
  },
  {
   "text": "*treo* *dây* đã cho",
   "start": 3.148,
   "end": 4.078
  },
  {
   "text": "mọi người thấy.",
   "start": 4.078,
   "end": 4.79
  }
 ],
 [
  {
   "text": "Hóa ra *mặt* *phẳng*",
   "start": 0.47,
   "end": 1.973
  },
  {
   "text": "*đung* *đưa* của nó",
   "start": 1.973,
   "end": 3.477
  },
  {
   "text": "còn *chầm* *chậm* *xoay*.",
   "start": 3.477,
   "end": 5.1
  }
 ],
 [
  {
   "text": "Vậy *vì*",
   "start": 0.39,
   "end": 0.866
  },
  {
   "text": "*sao* *nó* *xoay*,",
   "start": 0.866,
   "end": 1.921
  },
  {
   "text": "và nói gì",
   "start": 1.921,
   "end": 2.635
  },
  {
   "text": "về *Trái* *Đất*?",
   "start": 2.635,
   "end": 3.58
  }
 ],
 [
  {
   "text": "Người làm thí",
   "start": 0.39,
   "end": 1.24
  },
  {
   "text": "nghiệm là *Phu-cô*.",
   "start": 1.24,
   "end": 2.21
  }
 ],
 [
  {
   "text": "Treo *quả* *nặng*",
   "start": 0.41,
   "end": 1.155
  },
  {
   "text": "*28* *ki-lô-gam* vào *dây*",
   "start": 1.155,
   "end": 2.646
  },
  {
   "text": "*dài* *67* *mét*,",
   "start": 2.646,
   "end": 4.228
  },
  {
   "text": "từ mái",
   "start": 4.228,
   "end": 4.725
  },
  {
   "text": "vòm *đền* *Păng-tê-ông*.",
   "start": 4.725,
   "end": 5.59
  }
 ],
 [
  {
   "text": "*67* *mét* cao hơn",
   "start": 0.41,
   "end": 2.015
  },
  {
   "text": "*20* *tầng* *nhà*.",
   "start": 2.015,
   "end": 3.19
  }
 ],
 [
  {
   "text": "Dây dài nên",
   "start": 0.46,
   "end": 1.256
  },
  {
   "text": "quả nặng *đung*",
   "start": 1.256,
   "end": 2.052
  },
  {
   "text": "*đưa* *rất* *chậm*,",
   "start": 2.052,
   "end": 2.848
  },
  {
   "text": "ai cũng *nhìn* *kịp*.",
   "start": 2.848,
   "end": 4.3
  }
 ],
 [
  {
   "text": "Đặt *tờ* *giấy*",
   "start": 0.16,
   "end": 1.298
  },
  {
   "text": "lên *bàn* *xoay*,",
   "start": 1.298,
   "end": 2.486
  },
  {
   "text": "dùng thước vẽ *đường*",
   "start": 2.486,
   "end": 4.063
  },
  {
   "text": "*thẳng* khi bàn quay.",
   "start": 4.063,
   "end": 5.5
  }
 ],
 [
  {
   "text": "Khi bàn dừng,",
   "start": 0.47,
   "end": 1.285
  },
  {
   "text": "đường trên",
   "start": 1.285,
   "end": 2.098
  },
  {
   "text": "giấy *bị* *cong*,",
   "start": 2.098,
   "end": 3.503
  },
  {
   "text": "dù tay *vẽ* *thẳng*.",
   "start": 3.503,
   "end": 4.71
  }
 ],
 [
  {
   "text": "Quả nặng",
   "start": 0.3,
   "end": 0.914
  },
  {
   "text": "như *cây* *bút*:",
   "start": 0.914,
   "end": 1.945
  },
  {
   "text": "cứ đung đưa theo",
   "start": 1.945,
   "end": 3.172
  },
  {
   "text": "*một* *hướng* *cố* *định*.",
   "start": 3.172,
   "end": 4.52
  }
 ],
 [
  {
   "text": "Còn *mặt* *đất*",
   "start": 0.38,
   "end": 1.182
  },
  {
   "text": "như *tờ* *giấy*,",
   "start": 1.182,
   "end": 1.984
  },
  {
   "text": "đang *xoay*",
   "start": 1.984,
   "end": 2.738
  },
  {
   "text": "*cùng* *Trái* *Đất*.",
   "start": 2.738,
   "end": 3.95
  }
 ],
 [
  {
   "text": "Nên người đứng",
   "start": 0.47,
   "end": 1.327
  },
  {
   "text": "dưới thấy mặt",
   "start": 1.327,
   "end": 2.183
  },
  {
   "text": "phẳng *lệch* *dần*.",
   "start": 2.183,
   "end": 3.16
  }
 ],
 [
  {
   "text": "Ở *Bắc* *Cực*,",
   "start": 0.33,
   "end": 1.176
  },
  {
   "text": "xoay *trọn* *một* *vòng*",
   "start": 1.176,
   "end": 2.304
  },
  {
   "text": "trong *một* *ngày*.",
   "start": 2.304,
   "end": 3.27
  }
 ],
 [
  {
   "text": "Trái Đất quay *360*",
   "start": 0.4,
   "end": 1.806
  },
  {
   "text": "*độ* trong *24* *giờ*.",
   "start": 1.806,
   "end": 2.98
  }
 ],
 [
  {
   "text": "*360* *÷* *24* =",
   "start": 0.31,
   "end": 1.804
  },
  {
   "text": "*15* *độ* mỗi giờ.",
   "start": 1.804,
   "end": 2.82
  }
 ],
 [
  {
   "text": "Nhưng đền ở *Pa-ri*,",
   "start": 0.38,
   "end": 1.87
  },
  {
   "text": "*không* *ở* *Bắc* *Cực*,",
   "start": 1.87,
   "end": 3.37
  },
  {
   "text": "nên xoay *chậm* *hơn*.",
   "start": 3.37,
   "end": 4.57
  }
 ],
 [
  {
   "text": "Tốc độ =",
   "start": 0.44,
   "end": 1.378
  },
  {
   "text": "*15* *độ* × *sin*",
   "start": 1.378,
   "end": 3.382
  },
  {
   "text": "*của* *vĩ* *độ*.",
   "start": 3.382,
   "end": 4.44
  }
 ],
 [
  {
   "text": "Sin vĩ độ:",
   "start": 0.43,
   "end": 1.391
  },
  {
   "text": "*0* *ở* *xích* *đạo*,",
   "start": 1.391,
   "end": 2.629
  },
  {
   "text": "*1* *ở* *cực*.",
   "start": 2.629,
   "end": 3.75
  }
 ],
 [
  {
   "text": "Pa-ri ở *khoảng*",
   "start": 0.44,
   "end": 1.336
  },
  {
   "text": "*48,8* *độ* *Bắc*,",
   "start": 1.336,
   "end": 3.588
  },
  {
   "text": "sin *khoảng* *0,75*.",
   "start": 3.588,
   "end": 5.5
  }
 ],
 [
  {
   "text": "*15* *×* *0,75*",
   "start": 0.45,
   "end": 2.431
  },
  {
   "text": "= *khoảng* *11,3*",
   "start": 2.431,
   "end": 4.019
  },
  {
   "text": "*độ* mỗi giờ.",
   "start": 4.019,
   "end": 4.67
  }
 ],
 [
  {
   "text": "Đúng như Phu-cô thấy:",
   "start": 0.46,
   "end": 1.395
  },
  {
   "text": "*hơn* *11*",
   "start": 1.395,
   "end": 2.659
  },
  {
   "text": "*độ* mỗi giờ.",
   "start": 2.659,
   "end": 3.48
  }
 ],
 [
  {
   "text": "*360* *÷* *11,3*",
   "start": 0.46,
   "end": 3.178
  },
  {
   "text": "= *khoảng* *32*",
   "start": 3.178,
   "end": 4.185
  },
  {
   "text": "*giờ* một vòng.",
   "start": 4.185,
   "end": 4.91
  }
 ],
 [
  {
   "text": "Ở *xích* *đạo*,",
   "start": 0.41,
   "end": 1.335
  },
  {
   "text": "sin *bằng* *0*,",
   "start": 1.335,
   "end": 2.603
  },
  {
   "text": "quả lắc *không* *xoay*.",
   "start": 2.603,
   "end": 3.73
  }
 ],
 [
  {
   "text": "Thí nghiệm đơn",
   "start": 0.4,
   "end": 1.164
  },
  {
   "text": "giản *đầu* *tiên*",
   "start": 1.164,
   "end": 2.028
  },
  {
   "text": "cho thấy *trực* *tiếp*",
   "start": 2.028,
   "end": 3.436
  },
  {
   "text": "Trái Đất quay.",
   "start": 3.436,
   "end": 4.47
  }
 ],
 [
  {
   "text": "Chỉ cần *quả* *nặng*",
   "start": 0.28,
   "end": 1.327
  },
  {
   "text": "*và* *sợi* *dây*,",
   "start": 1.327,
   "end": 2.243
  },
  {
   "text": "đứng yên trong phòng,",
   "start": 2.243,
   "end": 3.881
  },
  {
   "text": "ta biết",
   "start": 3.881,
   "end": 4.404
  },
  {
   "text": "*Trái* *Đất* *quay*.",
   "start": 4.404,
   "end": 5.31
  }
 ],
 [
  {
   "text": "Quả lắc xoay vì",
   "start": 0.45,
   "end": 1.972
  },
  {
   "text": "*chính* *ta* *đang* *xoay*",
   "start": 1.972,
   "end": 3.264
  },
  {
   "text": "cùng Trái Đất.",
   "start": 3.264,
   "end": 4.27
  }
 ]
]