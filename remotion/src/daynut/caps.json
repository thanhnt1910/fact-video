  {
   "text": "*ki-lô-mét* *mỗi* *giờ*.",
   "start": 5.435,
   "end": 6.19
  }
 ],
 [
  {
   "text": "Cứ *nửa* *giờ*",
   "start": 0.25,
   "end": 1.098
  },
  {
   "text": "hoặc lâu hơn,",
   "start": 1.098,
   "end": 1.986
