  {
   "text": "*192* *hải* *lý*.",
   "start": 4.343,
   "end": 5.94
  }
 ],
 [
  {
   "text": "Đó là",
   "start": 0.33,
   "end": 0.804
  },
  {
   "text": "khoảng *356* *ki-lô-mét*,",
   "start": 0.804,
   "end": 2.805
  },
  {
   "text": "nên thủy thủ",
   "start": 2.805,
   "end": 3.517
  },
  {
   "text": "*biết* *mình* *đã*",
   "start": 3.517,
   "end": 4.228
  },
  {
   "text": "*đi* *bao* *xa*.",
   "start": 4.228,
   "end": 5.06
  }
 ],
 [
  {
   "text": "Giữa biển",
   "start": 0.43,
   "end": 0.903
  },
