   "text": "cho *số* *nút* đúng",
   "start": 2.663,
   "end": 3.904
  },
  {
   "text": "bằng *tốc* *độ*.",
   "start": 3.904,
   "end": 4.82
  }
 ],
 [
  {
   "text": "Mốc để so là",
   "start": 0.5,
   "end": 1.425
  },
  {
   "text": "*một* *hải* *lý*,",
   "start": 1.425,
   "end": 2.118
  },
  {
   "text": "quãng tàu đi",
   "start": 2.118,
   "end": 2.922
  },
  {
   "text": "trong *một* *giờ* khi",
   "start": 2.922,
   "end": 3.846
  },
  {
   "text": "chạy *một* *nút*.",
   "start": 3.846,
   "end": 4.66
  }
 ],
 [
  {
   "text": "*1* *hải* *lý*",
   "start": 0.38,
   "end": 1.084
  },
  {
   "text": "dài *1.852* *mét*.",
   "start": 1.084,
   "end": 3.08
  }
 ],
 [
  {
   "text": "Con số ấy",
   "start": 0.44,
   "end": 1.094
  },
  {
   "text": "có lý do:",
   "start": 1.094,
   "end": 2.078
  },
  {
   "text": "*1* *hải* *lý*",
   "start": 2.078,
   "end": 2.972
  },
  {
   "text": "ứng với *một*",
   "start": 2.972,
   "end": 3.626
  },
  {
   "text": "*phút* *vĩ* *độ*.",
   "start": 3.626,
   "end": 4.4
  }
 ],
 [
  {
   "text": "Vòng quanh Trái",
   "start": 0.4,
   "end": 0.966
  },
  {
   "text": "Đất có *21.600*",
   "start": 0.966,
   "end": 2.664
  },
  {
   "text": "*phút* như vậy.",
   "start": 2.664,
   "end": 3.35
  }
 ],
 [
  {
   "text": "*40.000* *÷* *21.600* ra",
   "start": 0.42,
   "end": 4.013
  },
  {
   "text": "khoảng *1,85* *ki-lô-mét*.",
   "start": 4.013,
   "end": 5.67
  }
 ],
 [
  {
   "text": "Đồng hồ cát chảy",
   "start": 0.43,
   "end": 1.321
  },
  {
   "text": "hết trong *28* *giây*,",
   "start": 1.321,
   "end": 3.019
