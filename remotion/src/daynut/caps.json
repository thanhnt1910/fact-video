[
 [
  {
   "text": "Giữa biển mênh mông",
   "start": 0.3,
   "end": 1.302
  },
  {
   "text": "*không* *có* *cột* *mốc*:",
   "start": 1.302,
   "end": 2.305
  },
  {
   "text": "làm sao biết tàu",
   "start": 2.305,
   "end": 3.637
  },
  {
   "text": "*chạy* *nhanh* *bao* *nhiêu*?",
   "start": 3.637,
   "end": 4.76
  }
 ],
 [
  {
   "text": "Nhưng thủy thủ xưa",
   "start": 0.43,
   "end": 1.538
  },
  {
   "text": "làm được chỉ với",
   "start": 1.538,
   "end": 2.807
  },
  {
   "text": "*một* *mảnh* *gỗ*,",
   "start": 2.807,
   "end": 3.533
  },
  {
   "text": "*một* *sợi* *dây* và",
   "start": 3.533,
   "end": 4.732
  },
  {
   "text": "*một* *đồng* *hồ* *cát*.",
   "start": 4.732,
   "end": 6.03
  }
 ],
 [
  {
   "text": "Nhờ sợi dây ấy,",
   "start": 0.37,
   "end": 1.244
  },
  {
   "text": "đến nay *tốc*",
   "start": 1.244,
   "end": 2.099
  },
  {
   "text": "*độ* *tàu* vẫn",
   "start": 2.099,
   "end": 2.755
  },
  {
   "text": "tính bằng *nút*.",
   "start": 2.755,
   "end": 3.53
  }
 ],
 [
  {
   "text": "Muốn biết tốc độ,",
   "start": 0.33,
   "end": 1.53
  },
  {
   "text": "cần *quãng* *đường*",
   "start": 1.53,
   "end": 2.295
  },
  {
   "text": "và *thời* *gian*.",
   "start": 2.295,
   "end": 3.18
  }
 ],
 [
  {
   "text": "Nhưng trên biển *không*",
   "start": 0.42,
   "end": 1.227
  },
  {
   "text": "*có* *cột* *cây* *số*",
   "start": 1.227,
   "end": 2.033
  },
  {
   "text": "để đếm quãng đường.",
   "start": 2.033,
   "end": 2.96
  }
 ],
 [
  {
   "text": "Họ lấy",
   "start": 0.42,
   "end": 0.83
  },
  {
   "text": "*nước* *làm* *mốc*:",
   "start": 0.83,
   "end": 1.445
  },
  {
   "text": "thả xuống biển",
   "start": 1.445,
   "end": 2.56
  },
  {
   "text": "*một* *mảnh* *gỗ*,",
   "start": 2.56,
   "end": 3.505
  },
  {
   "text": "nó gần",
   "start": 3.505,
   "end": 3.915
  },
  {
   "text": "như *đứng* *yên*.",
   "start": 3.915,
   "end": 4.65
  }
 ],
 [
  {
   "text": "Tàu chạy đi,",
   "start": 0.38,
   "end": 1.482
  },
  {
   "text": "*dây* *buộc* *vào*",
   "start": 1.482,
   "end": 2.355
  },
  {
   "text": "*mảnh* *gỗ* tuột",
   "start": 2.355,
   "end": 3.318
  },
  {
   "text": "dần khỏi cuộn.",
   "start": 3.318,
   "end": 4.18
  }
 ],
 [
  {
   "text": "Trên dây có",
   "start": 0.38,
   "end": 1.037
  },
  {
   "text": "những *nút* *thắt*",
   "start": 1.037,
   "end": 1.693
  },
  {
   "text": "cách đều nhau.",
   "start": 1.693,
   "end": 2.47
  }
 ],
 [
  {
   "text": "Mỗi *nút* chạy",
