   "text": "được khoảng *0,5* *mét*.",
   "start": 2.958,
   "end": 4.18
  }
 ],
 [
  {
   "text": "Nhân với *28* *giây*,",
   "start": 0.32,
   "end": 1.612
  },
  {
   "text": "ra khoảng *14,4* *mét*.",
   "start": 1.612,
   "end": 4.13
  }
 ],
 [
  {
   "text": "Vậy hai nút",
   "start": 0.29,
   "end": 1.002
  },
  {
   "text": "liền nhau cách nhau",
   "start": 1.002,
   "end": 2.058
