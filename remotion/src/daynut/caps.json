   "text": "tức *8* *hải*",
   "start": 1.366,
   "end": 2.488
  },
  {
   "text": "*lý* mỗi giờ.",
   "start": 2.488,
   "end": 3.2
  }
 ],
 [
  {
   "text": "Đổi ra ki-lô-mét:",
