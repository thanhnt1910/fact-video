   "start": 1.286,
   "end": 2.172
  },
  {
   "text": "là tàu đã *đi*",
   "start": 2.172,
   "end": 3.244
  },
  {
   "text": "*thêm* *một* *đoạn*.",
   "start": 3.244,
   "end": 4.1
  }
 ],
 [
  {
   "text": "Lật *đồng* *hồ* *cát*,",
   "start": 0.42,
   "end": 1.471
  },
  {
   "text": "rồi đếm *bao*",
   "start": 1.471,
   "end": 2.477
  },
  {
   "text": "*nhiêu* *nút* tuột",
   "start": 2.477,
   "end": 3.183
  },
  {
   "text": "ra cho tới khi",
   "start": 3.183,
   "end": 4.424
  },
  {
   "text": "cát chảy hết.",
   "start": 4.424,
   "end": 5.41
  }
 ],
 [
  {
   "text": "Cách đo này",
   "start": 0.41,
   "end": 0.95
  },
  {
   "text": "đã có từ",
   "start": 0.95,
   "end": 1.49
  },
  {
   "text": "*thế* *kỷ* *16*.",
   "start": 1.49,
   "end": 2.51
  }
 ],
 [
  {
   "text": "Khoảng cách giữa hai",
   "start": 0.43,
