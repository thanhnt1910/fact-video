   "text": "không cột mốc,",
   "start": 0.903,
   "end": 1.612
  },
  {
   "text": "*mảnh* *gỗ*,",
   "start": 1.612,
   "end": 2.546
  },
  {
   "text": "*dây* *thắt* *nút*",
   "start": 2.546,
   "end": 3.485
  },
  {
   "text": "và *đồng* *hồ*",
   "start": 3.485,
   "end": 4.334
  },
  {
   "text": "*cát* đã đo được",
   "start": 4.334,
   "end": 5.39
