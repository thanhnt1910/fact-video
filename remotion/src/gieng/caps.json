[
 [
  {
   "text": "Thả *hòn*",
   "start": 0.4,
   "end": 0.938
  },
  {
   "text": "*đá* xuống giếng,",
   "start": 0.938,
   "end": 1.984
  },
  {
   "text": "*đếm* *giây* tới khi",
   "start": 1.984,
   "end": 3.059
  },
  {
   "text": "nghe tiếng tõm:",
   "start": 3.059,
   "end": 4.255
  },
  {
   "text": "giếng *sâu* *bao* *nhiêu*?",
   "start": 4.255,
   "end": 5.45
  }
 ],
 [
  {
   "text": "Nhưng đá rơi *càng*",
   "start": 0.27,
   "end": 1.237
  },
  {
   "text": "*lúc* *càng* *nhanh*,",
   "start": 1.237,
   "end": 2.312
  },
  {
   "text": "nên không thể",
   "start": 2.312,
   "end": 3.038
  },
  {
   "text": "nhân với *một* *tốc*",
   "start": 3.038,
   "end": 4.135
  },
  {
   "text": "*độ* *cố* *định*.",
   "start": 4.135,
   "end": 4.98
  }
 ],
 [
  {
   "text": "Hóa ra có *một*",
   "start": 0.47,
   "end": 1.499
  },
  {
   "text": "*quy* *luật* *rất* *gọn*,",
   "start": 1.499,
   "end": 2.779
  },
  {
   "text": "tìm ra nhờ *một*",
   "start": 2.779,
   "end": 3.938
  },
  {
   "text": "*cái* *máng* *gỗ*.",
   "start": 3.938,
   "end": 4.83
  }
 ],
 [
  {
   "text": "Cách đây",
   "start": 0.25,
   "end": 0.614
  },
  {
   "text": "*hơn* *400* *năm*,",
   "start": 0.614,
   "end": 2.036
  },
  {
   "text": "*Galileo* muốn đo",
   "start": 2.036,
   "end": 2.945
  },
  {
   "text": "chuyện *vật* *rơi*.",
   "start": 2.945,
   "end": 3.61
  }
 ],
 [
  {
   "text": "Nhưng đá",
   "start": 0.43,
   "end": 0.841
  },
  {
   "text": "rơi *quá* *nhanh*,",
   "start": 0.841,
   "end": 1.457
  },
  {
   "text": "mà ông *chưa* *có*",
   "start": 1.457,
   "end": 2.578
  },
  {
   "text": "*đồng* *hồ* *bấm* *giây*.",
   "start": 2.578,
   "end": 3.52
  }
 ],
 [
  {
   "text": "Vậy ông cho nó",
   "start": 0.37,
   "end": 1.413
  },
  {
   "text": "*rơi* *chậm* *lại*:",
   "start": 1.413,
   "end": 2.655
  },
  {
   "text": "lăn *quả* *bóng* xuống",
   "start": 2.655,
   "end": 3.698
  },
  {
   "text": "*máng* *dốc* *nhẹ*.",
   "start": 3.698,
   "end": 4.6
  }
 ],
 [
  {
   "text": "Máng gỗ dài",
   "start": 0.45,
   "end": 1.345
  },
  {
   "text": "*khoảng* *6* *mét*,",
   "start": 1.345,
   "end": 2.239
  },
  {
   "text": "khoét *rãnh*",
   "start": 2.239,
   "end": 2.835
  },
  {
   "text": "*thẳng* *và* *nhẵn*.",
   "start": 2.835,
   "end": 3.85
  }
 ],
 [
  {
   "text": "Bóng lăn xuống",
   "start": 0.44,
   "end": 1.167
  },
  {
   "text": "dốc cũng *nhanh*",
   "start": 1.167,
   "end": 1.994
  },
  {
   "text": "*dần* như rơi,",
   "start": 1.994,
   "end": 2.721
  },
  {
   "text": "chỉ là *chậm* *hơn*.",
   "start": 2.721,
   "end": 4.04
  }
 ],
 [
  {
   "text": "Ông đo thời gian",
   "start": 0.47,
   "end": 1.51
  },
  {
   "text": "bằng *đồng* *hồ* *nước*.",
   "start": 1.51,
   "end": 2.77
  }
 ],
 [
  {
   "text": "Ông *đánh* *dấu*",
   "start": 0.38,
   "end": 1.07
  },
  {
   "text": "*chỗ* *bóng* *tới*",
   "start": 1.07,
   "end": 1.76
  },
  {
   "text": "sau những khoảng *thời*",
   "start": 1.76,
   "end": 2.68
  },
  {
   "text": "*gian* *bằng* *nhau*.",
   "start": 2.68,
   "end": 3.49
  }
 ],
 [
  {
   "text": "Sau *2*",
   "start": 0.37,
   "end": 1.106
  },
  {
   "text": "*khoảng* thời gian,",
   "start": 1.106,
   "end": 1.836
  },
  {
   "text": "đi xa",
   "start": 1.836,
   "end": 2.632
  },
  {
   "text": "gấp *4* *lần*;",
   "start": 2.632,
   "end": 3.361
  },
  {
   "text": "sau *3* *khoảng*,",
   "start": 3.361,
   "end": 4.411
  },
  {
   "text": "gấp *9* *lần*.",
   "start": 4.411,
   "end": 5.38
  }
 ],
 [
  {
   "text": "*4* *=*",
   "start": 0.42,
   "end": 0.818
  },
  {
   "text": "*2* *×* *2*,",
   "start": 0.818,
   "end": 1.613
  },
  {
   "text": "*9* *=*",
   "start": 1.613,
   "end": 2.521
  },
  {
   "text": "*3* *×* *3*:",
   "start": 2.521,
   "end": 3.117
  },
  {
   "text": "đó là các",
   "start": 3.117,
   "end": 4.134
  },
  {
   "text": "*số* *bình* *phương*.",
   "start": 4.134,
   "end": 4.85
  }
 ],
 [
  {
   "text": "Vậy *quãng* *đường* *đi*",
   "start": 0.45,
   "end": 1.33
  },
  {
   "text": "*được* lớn lên theo",
   "start": 1.33,
   "end": 2.36
  },
  {
   "text": "*bình* *phương* *thời* *gian*.",
   "start": 2.36,
   "end": 3.36
  }
 ],
 [
  {
   "text": "Với vật rơi:",
   "start": 0.34,
   "end": 2.07
  },
  {
   "text": "*quãng* *đường* *=*",
   "start": 2.07,
   "end": 3.03
  },
  {
   "text": "*½* *×* *g*",
   "start": 3.03,
   "end": 4.48
  },
  {
   "text": "*×* *thời* *gian²*.",
   "start": 4.48,
   "end": 5.56
  }
 ],
 [
  {
   "text": "Số *g* cho biết",
   "start": 0.51,
   "end": 1.463
  },
  {
   "text": "mỗi giây vật",
   "start": 1.463,
   "end": 2.438
  },
  {
   "text": "*nhanh* *thêm* *chừng* *9,8*",
   "start": 2.438,
   "end": 4.105
  },
  {
   "text": "*mét* mỗi giây.",
   "start": 4.105,
   "end": 4.94
  }
 ],
 [
  {
   "text": "Rơi *1* *giây*:",
   "start": 0.41,
   "end": 1.244
  },
  {
   "text": "*½* *×* *9,8*",
   "start": 1.244,
   "end": 3.651
  },
  {
   "text": "*×* *1* *×* *1*",
   "start": 3.651,
   "end": 5.143
  },
  {
   "text": "= *4,9* *mét*.",
   "start": 5.143,
   "end": 7.79
  }
 ],
 [
  {
   "text": "Rơi *2* *giây*:",
   "start": 0.39,
   "end": 1.014
  },
  {
   "text": "*½* *×* *9,8* *×*",
   "start": 1.014,
   "end": 2.759
  },
  {
   "text": "*4* = *19,6* *mét*.",
   "start": 2.759,
   "end": 4.99
  }
 ],
 [
  {
   "text": "Rơi *3* *giây*:",
   "start": 0.27,
   "end": 0.958
  },
  {
   "text": "*½* *×* *9,8* *×*",
   "start": 0.958,
   "end": 3.095
  },
  {
   "text": "*9* = *44,1* *mét*.",
   "start": 3.095,
   "end": 5.64
  }
 ],
 [
  {
   "text": "Vậy đếm",
   "start": 0.29,
   "end": 0.75
  },
  {
   "text": "được *3* *giây*,",
   "start": 0.75,
   "end": 1.44
  },
  {
   "text": "giếng sâu",
   "start": 1.44,
   "end": 2.22
  },
  {
   "text": "*khoảng* *44* *mét*.",
   "start": 2.22,
   "end": 3.62
  }
 ],
 [
  {
   "text": "Cao ngang tòa nhà",
   "start": 0.41,
   "end": 1.543
  },
  {
   "text": "*khoảng* *15* *tầng*.",
   "start": 1.543,
   "end": 3.17
  }
 ],
 [
  {
   "text": "Nhưng đá *nặng* và",
   "start": 0.35,
   "end": 1.234
  },
  {
   "text": "đá *nhẹ* có rơi",
   "start": 1.234,
   "end": 2.117
  },
  {
   "text": "*khác* *nhau* không?",
   "start": 2.117,
   "end": 2.9
  }
 ],
 [
  {
   "text": "Lông chim rơi",
   "start": 0.36,
   "end": 1.142
  },
  {
   "text": "chậm vì *không*",
   "start": 1.142,
   "end": 2.045
  },
  {
   "text": "*khí* *cản* nó *nhiều*",
   "start": 2.045,
   "end": 3.088
  },
  {
   "text": "*hơn* viên đá.",
   "start": 3.088,
   "end": 3.99
  }
 ],
 [
  {
   "text": "*Galileo* nhận ra:",
   "start": 0.4,
   "end": 1.833
  },
  {
   "text": "nếu *không*",
   "start": 1.833,
   "end": 2.263
  },
  {
   "text": "*có* *không* *khí*,",
   "start": 2.263,
   "end": 3.227
  },
  {
   "text": "mọi vật",
   "start": 3.227,
   "end": 3.656
  },
  {
   "text": "*rơi* *cùng* *lúc*.",
   "start": 3.656,
   "end": 4.42
  }
 ],
 [
  {
   "text": "Vì vậy công thức",
   "start": 0.31,
   "end": 1.328
  },
  {
   "text": "*không* *cần* *biết* *đá*",
   "start": 1.328,
   "end": 2.346
  },
  {
   "text": "*nặng* *bao* *nhiêu*.",
   "start": 2.346,
   "end": 3.23
  }
 ],
 [
  {
   "text": "Nhưng *tiếng* *tõm*",
   "start": 0.41,
   "end": 1.019
  },
  {
   "text": "cũng mất thời",
   "start": 1.019,
   "end": 1.628
  },
  {
   "text": "gian bay lên:",
   "start": 1.628,
   "end": 2.237
  },
  {
   "text": "*khoảng* *1* *phần*",
   "start": 2.237,
   "end": 3.246
  },
  {
   "text": "*8* *giây* với",
   "start": 3.246,
   "end": 3.855
  },
  {
   "text": "giếng *44* *mét*.",
   "start": 3.855,
   "end": 4.99
  }
 ],
 [
  {
   "text": "Nên với giếng sâu,",
   "start": 0.41,
   "end": 1.29
  },
  {
   "text": "nên *trừ* *bớt* *thời*",
   "start": 1.29,
   "end": 2.29
  },
  {
   "text": "*gian* *ấy* khỏi số",
   "start": 2.29,
   "end": 3.17
  },
  {
   "text": "giây đã đếm.",
   "start": 3.17,
   "end": 3.95
  }
 ],
 [
  {
   "text": "Vậy chỉ *một*",
   "start": 0.34,
   "end": 0.994
  },
  {
   "text": "*hòn* *đá* và",
   "start": 0.994,
   "end": 1.748
  },
  {
   "text": "*vài* *giây* *đếm*,",
   "start": 1.748,
   "end": 2.672
  },
  {
   "text": "ta biết giếng",
   "start": 2.672,
   "end": 3.326
  },
  {
   "text": "*sâu* *bao* *nhiêu*.",
   "start": 3.326,
   "end": 4.1
  }
 ],
 [
  {
   "text": "Nhờ quy luật *Galileo*",
   "start": 0.35,
   "end": 1.587
  },
  {
   "text": "tìm ra từ *một*",
   "start": 1.587,
   "end": 2.552
  },
  {
   "text": "*cái* *máng* *gỗ*.",
   "start": 2.552,
   "end": 3.29
  }
 ]
]