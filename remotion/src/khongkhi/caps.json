[
 [
  {
   "text": "*Không* *khí*",
   "start": 0.32,
   "end": 0.822
  },
  {
   "text": "có nặng không,",
   "start": 0.822,
   "end": 1.574
  },
  {
   "text": "và nếu có thì",
   "start": 1.574,
   "end": 2.828
  },
  {
   "text": "*nặng* *bao* *nhiêu*?",
   "start": 2.828,
   "end": 3.7
  }
 ],
 [
  {
   "text": "Nhưng ta chẳng thể",
   "start": 0.42,
   "end": 1.427
  },
  {
   "text": "bỏ *cả* *bầu* *trời*",
   "start": 1.427,
   "end": 2.525
  },
  {
   "text": "lên *bàn* *cân*.",
   "start": 2.525,
   "end": 3.4
  }
 ],
 [
  {
   "text": "Hóa ra chỉ",
   "start": 0.32,
   "end": 0.968
  },
  {
   "text": "cần *một* *ống*",
   "start": 0.968,
   "end": 1.617
  },
  {
   "text": "*thủy* *tinh* và *một*",
   "start": 1.617,
   "end": 2.792
  },
  {
   "text": "*chậu* *thủy* *ngân*.",
   "start": 2.792,
   "end": 3.56
  }
 ],
 [
  {
   "text": "Vậy cái ống",
   "start": 0.4,
   "end": 1.081
  },
  {
   "text": "ấy *cân* *không* *khí*",
   "start": 1.081,
   "end": 2.079
  },
  {
   "text": "bằng cách nào?",
   "start": 2.079,
   "end": 2.88
  }
 ],
 [
  {
   "text": "Người ta dựng *một*",
   "start": 0.41,
   "end": 1.492
  },
  {
   "text": "*ống* *rất* *dài*,",
   "start": 1.492,
   "end": 2.324
  },
  {
   "text": "đổ đầy nước,",
   "start": 2.324,
   "end": 3.406
  },
  {
   "text": "rồi mở đáy ống",
   "start": 3.406,
   "end": 4.568
  },
  {
   "text": "trong *một* *chậu* *nước*.",
   "start": 4.568,
   "end": 5.61
  }
 ],
 [
  {
   "text": "Nước tụt xuống",
   "start": 0.45,
   "end": 1.386
  },
  {
   "text": "rồi dừng ở",
   "start": 1.386,
   "end": 2.253
  },
  {
   "text": "*khoảng* *10* *mét*,",
   "start": 2.253,
   "end": 3.647
  },
  {
   "text": "phía trên để",
   "start": 3.647,
   "end": 5.034
  },
  {
   "text": "lại *khoảng* *trống*.",
   "start": 5.034,
   "end": 5.9
  }
 ],
 [
  {
   "text": "Vì sao nước *dừng*",
   "start": 0.26,
   "end": 1.073
  },
  {
   "text": "*ở* *đó* mà không",
   "start": 1.073,
   "end": 1.987
  },
  {
   "text": "*chảy* *hết* ra ngoài?",
   "start": 1.987,
   "end": 2.92
  }
 ],
 [
  {
   "text": "*Tô-ri-xe-li* cho rằng không",
   "start": 0.45,
   "end": 1.725
  },
  {
   "text": "khí đang *đè* *lên*",
   "start": 1.725,
   "end": 3.319
  },
  {
   "text": "*mặt* *chậu* và *đỡ*",
   "start": 3.319,
   "end": 4.694
  },
  {
   "text": "*cột* *nước* lên.",
   "start": 4.694,
   "end": 5.77
  }
 ],
 [
  {
   "text": "Như *chiếc* *cân* *đĩa*:",
   "start": 0.51,
   "end": 1.865
  },
  {
   "text": "một bên",
   "start": 1.865,
   "end": 2.448
  },
  {
   "text": "*cột* *không* *khí*,",
   "start": 2.448,
   "end": 3.611
  },
  {
   "text": "bên kia *cột* *nước*,",
   "start": 3.611,
   "end": 5.086
  },
  {
   "text": "nặng bằng nhau.",
   "start": 5.086,
   "end": 6.08
  }
 ],
 [
  {
   "text": "Ống nước *cao* *10*",
   "start": 0.37,
   "end": 1.859
  },
  {
   "text": "*mét* quá khó dùng,",
   "start": 1.859,
   "end": 3.091
  },
  {
   "text": "nên ông *thay*",
   "start": 3.091,
   "end": 3.791
  },
  {
   "text": "*bằng* *thủy* *ngân*.",
   "start": 3.791,
   "end": 4.61
  }
 ],
 [
  {
   "text": "Thủy ngân nặng gấp",
   "start": 0.46,
   "end": 1.333
  },
  {
   "text": "*khoảng* *13,6* *lần* nước,",
   "start": 1.333,
   "end": 3.638
  },
  {
   "text": "nên cột",
   "start": 3.638,
   "end": 4.075
  },
  {
   "text": "*ngắn* *hơn* *nhiều*.",
   "start": 4.075,
   "end": 4.85
  }
 ],
 [
  {
   "text": "Đổ đầy thủy",
   "start": 0.45,
   "end": 1.218
  },
  {
   "text": "ngân vào ống *dài*",
   "start": 1.218,
   "end": 2.351
  },
  {
   "text": "*khoảng* *1* *mét*,",
   "start": 2.351,
   "end": 3.119
  },
  {
   "text": "bịt đầu,",
   "start": 3.119,
   "end": 4.051
  },
  {
   "text": "rồi *úp*",
   "start": 4.051,
   "end": 4.862
  },
  {
   "text": "*ngược* vào chậu.",
   "start": 4.862,
   "end": 5.75
  }
 ],
 [
  {
   "text": "Thủy ngân tụt xuống",
   "start": 0.47,
   "end": 1.593
  },
  {
   "text": "rồi *đứng* *yên* ở",
   "start": 1.593,
   "end": 2.716
  },
  {
   "text": "*khoảng* *76* *xen-ti-mét*.",
   "start": 2.716,
   "end": 4.24
  }
 ],
 [
  {
   "text": "Bây giờ,",
   "start": 0.49,
   "end": 0.922
  },
  {
   "text": "ta *cân* *không*",
   "start": 0.922,
   "end": 1.839
  },
  {
   "text": "*khí* bằng chính *cột*",
   "start": 1.839,
   "end": 2.702
  },
  {
   "text": "*thủy* *ngân* ấy.",
   "start": 2.702,
   "end": 3.47
  }
 ],
 [
  {
   "text": "Xét cột có đáy",
   "start": 0.39,
   "end": 1.55
  },
  {
   "text": "*1* *xen-ti-mét* *vuông*,",
   "start": 1.55,
   "end": 2.42
  },
  {
   "text": "cỡ *móng* *tay* *út*.",
   "start": 2.42,
   "end": 4.03
  }
 ],
 [
  {
   "text": "Mỗi xen-ti-mét khối",
   "start": 0.34,
   "end": 1.03
  },
  {
   "text": "thủy ngân nặng",
   "start": 1.03,
   "end": 1.72
  },
  {
   "text": "*khoảng* *13,6* *gam*.",
   "start": 1.72,
   "end": 3.68
  }
 ],
 [
  {
   "text": "Cột cao 76 xen-ti-mét,",
   "start": 0.35,
   "end": 1.547
  },
  {
   "text": "nên nặng *76*",
   "start": 1.547,
   "end": 2.854
  },
  {
   "text": "*nhân* *13,6* *gam*.",
   "start": 2.854,
   "end": 4.57
  }
 ],
 [
  {
   "text": "= *1* *033,6* *gam*",
   "start": 0.4,
   "end": 2.023
  },
  {
   "text": "≈ *1* *ki-lô-gam*.",
   "start": 2.023,
   "end": 2.63
  }
 ],
 [
  {
   "text": "Trên mỗi xen-ti-mét vuông,",
   "start": 0.37,
   "end": 1.628
  },
  {
   "text": "không khí *đè* *nặng*",
   "start": 1.628,
   "end": 3.156
  },
  {
   "text": "*như* *1* *ki-lô-gam*.",
   "start": 3.156,
   "end": 4.22
  }
 ],
 [
  {
   "text": "Ngày nay đo được",
   "start": 0.38,
   "end": 1.665
  },
  {
   "text": "*khoảng* *1,03* *ki-lô-gam*,",
   "start": 1.665,
   "end": 3.835
  },
  {
   "text": "*khớp* với phép tính.",
   "start": 3.835,
   "end": 5.35
  }
 ],
 [
  {
   "text": "Thử bằng nước:",
   "start": 0.23,
   "end": 0.974
  },
  {
   "text": "nước *nhẹ* *hơn* *nhiều*,",
   "start": 0.974,
   "end": 2.25
  },
  {
   "text": "nên cột nước phải",
   "start": 2.25,
   "end": 3.406
  },
  {
   "text": "*cao* *gấp* *13,6* *lần*.",
   "start": 3.406,
   "end": 5.43
  }
 ],
 [
  {
   "text": "*76* *xen-ti-mét* *×* *13,6*",
   "start": 0.41,
   "end": 2.522
  },
  {
   "text": "≈ *10,3* *mét*.",
   "start": 2.522,
   "end": 4.3
  }
 ],
 [
  {
   "text": "*Đúng* *bằng* cột",
   "start": 0.38,
   "end": 1.037
  },
  {
   "text": "nước *10* *mét* đã",
   "start": 1.037,
   "end": 2.462
  },
  {
   "text": "thấy trước đó.",
   "start": 2.462,
   "end": 3.24
  }
 ],
 [
  {
   "text": "Nếu không khí",
   "start": 0.4,
   "end": 1.011
  },
  {
   "text": "có trọng lượng,",
   "start": 1.011,
   "end": 1.902
  },
  {
   "text": "*lên* *cao* sẽ",
   "start": 1.902,
   "end": 2.514
  },
  {
   "text": "còn *ít* *không* *khí*",
   "start": 2.514,
   "end": 3.329
  },
  {
   "text": "*đè* *lên* hơn.",
   "start": 3.329,
   "end": 4.06
  }
 ],
 [
  {
   "text": "Năm *1648*,",
   "start": 0.41,
   "end": 2.472
  },
  {
   "text": "*Pát-xcan* nhờ anh",
   "start": 2.472,
   "end": 3.111
  },
  {
   "text": "rể mang ống thủy",
   "start": 3.111,
   "end": 3.962
  },
  {
   "text": "ngân *lên* *núi*.",
   "start": 3.962,
   "end": 4.72
  }
 ],
 [
  {
   "text": "Càng lên cao,",
   "start": 0.41,
   "end": 1.091
  },
  {
   "text": "cột thủy ngân",
   "start": 1.091,
   "end": 2.002
  },
  {
   "text": "*càng* *thấp* *xuống*,",
   "start": 2.002,
   "end": 2.682
  },
  {
   "text": "*đúng* *như* *dự* *đoán*.",
   "start": 2.682,
   "end": 4.02
  }
 ],
 [
  {
   "text": "Gần mặt đất,",
   "start": 0.39,
   "end": 1.306
  },
  {
   "text": "cứ *lên*",
   "start": 1.306,
   "end": 1.67
  },
  {
   "text": "*cao* *100* *mét*,",
   "start": 1.67,
   "end": 3.173
  },
  {
   "text": "sức ép không khí",
   "start": 3.173,
   "end": 3.9
  },
  {
   "text": "*giảm* *khoảng* *1%*.",
   "start": 3.9,
   "end": 5.07
  }
 ],
 [
  {
   "text": "*1* *mét* *vuông* =",
   "start": 0.5,
   "end": 1.743
  },
  {
   "text": "*10* *000* xen-ti-mét vuông,",
   "start": 1.743,
   "end": 4.226
  },
  {
   "text": "nên không khí đè",
   "start": 4.226,
   "end": 5.569
  },
  {
   "text": "*khoảng* *10* *tấn*.",
   "start": 5.569,
   "end": 6.78
  }
 ],
 [
  {
   "text": "Ta không bị",
   "start": 0.47,
   "end": 1.082
  },
  {
   "text": "đè bẹp vì",
   "start": 1.082,
   "end": 1.905
  },
  {
   "text": "không khí *ép* *đều*",
   "start": 1.905,
   "end": 2.721
  },
  {
   "text": "*từ* *mọi* *phía*,",
   "start": 2.721,
   "end": 3.334
  },
  {
   "text": "cả *từ* *dưới* *lên*.",
   "start": 3.334,
   "end": 4.57
  }
 ],
 [
  {
   "text": "Không khí nặng",
   "start": 0.33,
   "end": 1.213
  },
  {
   "text": "*khoảng* *1* *ki-lô-gam* trên",
   "start": 1.213,
   "end": 2.391
  },
  {
   "text": "mỗi xen-ti-mét vuông,",
   "start": 2.391,
   "end": 3.274
  },
  {
   "text": "cân bằng *một*",
   "start": 3.274,
   "end": 4.567
  },
  {
   "text": "*ống* *thủy* *ngân*.",
   "start": 4.567,
   "end": 5.57
  }
 ]
]