   "start": 1.948,
   "end": 3.092
  },
  {
   "text": "Vì sao *đồng* *hồ*",
   "start": 3.092,
   "end": 3.884
  },
  {
   "text": "lại cho biết *tàu*",
   "start": 3.884,
   "end": 4.866
  },
  {
   "text": "*đang* *ở* *đâu*?",
   "start": 4.866,
   "end": 5.58
  }
 ],
 [
  {
   "text": "Cần *hai* *con* *số*.",
   "start": 0.42,
   "end": 2.017
  },
  {
   "text": "*Vĩ* *độ*,",
   "start": 2.017,
   "end": 2.74
  },
  {
   "text": "bắc hay nam,",
