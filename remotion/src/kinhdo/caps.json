[
 [
  {
   "text": "Năm *1714*,",
   "start": 0.5,
   "end": 2.14
  },
  {
   "text": "nước Anh treo",
   "start": 2.14,
   "end": 2.719
  },
  {
   "text": "thưởng *20* *000* *bảng*",
   "start": 2.719,
   "end": 5.679
  },
  {
   "text": "cho câu hỏi:",
   "start": 5.679,
   "end": 6.257
  },
  {
   "text": "*tàu* *của* *tôi* *đang*",
   "start": 6.257,
   "end": 7.609
  },
  {
   "text": "*ở* *đâu* giữa biển?",
   "start": 7.609,
   "end": 8.5
  }
 ],
 [
  {
   "text": "Người tìm ra",
   "start": 0.31,
   "end": 1.191
