  {
   "text": "lời giải không phải",
   "start": 1.191,
   "end": 2.366
  },
  {
   "text": "nhà thiên văn,",
   "start": 2.366,
   "end": 3.338
  },
  {
   "text": "mà là *một*",
   "start": 3.338,
   "end": 4.219
