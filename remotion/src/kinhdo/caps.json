   "end": 4.465
  },
  {
   "text": "*đo* *dễ*:",
   "start": 4.465,
   "end": 5.188
  },
  {
   "text": "đo *góc* *Mặt* *Trời*",
   "start": 5.188,
   "end": 7.305
  },
  {
   "text": "lúc giữa trưa.",
   "start": 7.305,
   "end": 8.51
  }
 ],
 [
  {
