   "text": "= *15°* mỗi giờ.",
   "start": 6.638,
   "end": 8.93
  }
 ],
 [
  {
   "text": "Giữa trưa trên tàu,",
   "start": 0.35,
   "end": 1.112
  },
  {
   "text": "đồng hồ nhà chỉ",
   "start": 1.112,
   "end": 2.154
  },
  {
   "text": "*3* *giờ* *chiều*.",
   "start": 2.154,
   "end": 3.393
