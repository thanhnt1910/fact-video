  {
   "text": "*ở* *cảng* *nhà*.",
   "start": 1.923,
   "end": 2.787
  },
  {
   "text": "Trái Đất quay:",
   "start": 2.787,
   "end": 3.371
  },
  {
   "text": "*360°* ÷ *24* *giờ*",
