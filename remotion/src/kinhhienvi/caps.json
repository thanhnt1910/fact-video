[[{"text": "Giọt nước có *1*", "start": 0.37, "end": 5.241}, {"text": "*triệu* sinh vật.", "start": 5.241, "end": 5.881}, {"text": "Làm sao *đếm*", "start": 5.881, "end": 6.52}, {"text": "thứ không thấy?", "start": 6.52, "end": 7.28}], [{"text": "Người đếm là", "start": 0.32, "end": 1.574}, {"text": "*một* *người* *bán* *vải*", "start": 1.574, "end": 3.486}, {"text": "ở Hà Lan.", "start": 3.486, "end": 4.98}], [{"text": "Vì sao đo được?", "start": 0.39, "end": 2.7}, {"text": "Ông dùng *hạt* *cát*.", "start": 2.7, "end": 6.47}], [{"text": "Kính một thấu kính,", "start": 0.42, "end": 1.269}, {"text": "phóng to", "start": 1.269, "end": 1.693}, {"text": "tới *275* *lần*.", "start": 1.693, "end": 6.68}], [{"text": "Thấy chưa đủ:", "start": 0.42, "end": 2.123}, {"text": "phải biết chúng", "start": 2.123, "end": 3.927}, {"text": "*to* *bao* *nhiêu*.", "start": 3.927, "end": 5.47}], [{"text": "So với *hạt* *cát*,", "start": 0.4, "end": 2.16}, {"text": "*hạt* *kê*,", "start": 2.16, "end": 3.745}, {"text": "*sợi* *tóc*.", "start": 3.745, "end": 4.85}], [{"text": "Hạt cát dài gấp", "start": 0.46, "end": 1.335}, {"text": "*12* *lần* con vật.", "start": 1.335, "end": 4.08}], [{"text": "Dài gấp 12", "start": 0.39, "end": 2.824}, {"text": "thì *thể* *tích*", "start": 2.824, "end": 3.446}, {"text": "không gấp 12.", "start": 3.446, "end": 6.97}], [{"text": "*12* *×* *12* *×*", "start": 0.42, "end": 3.865}, {"text": "*12* *=* *1* *728*.", "start": 3.865, "end": 8.14}], [{"text": "Hạt cát lớn", "start": 0.39, "end": 1.032}, {"text": "gấp *1* *728*", "start": 1.032, "end": 3.538}, {"text": "lần con vật.", "start": 3.538, "end": 4.3}], [{"text": "Loại dài bằng *1/4*:", "start": 0.36, "end": 2.323}, {"text": "4 × 4 ×", "start": 2.323, "end": 5.417}, {"text": "4 = *64*.", "start": 5.417, "end": 8.07}], [{"text": "1 728 × 64", "start": 0.46, "end": 4.185}, {"text": "= *110* *592* con", "start": 4.185, "end": 7.181}, {"text": "trong một hạt cát.", "start": 7.181, "end": 8.21}], [{"text": "Loại dài bằng *1/10*:", "start": 0.34, "end": 1.96}, {"text": "nhân thêm 1 000,", "start": 1.96, "end": 4.276}, {"text": "ra hơn", "start": 4.276, "end": 4.993}, {"text": "*110* *triệu* con.", "start": 4.993, "end": 6.29}], [{"text": "*100* hồng cầu dài", "start": 0.33, "end": 2.297}, {"text": "bằng hạt cát:", "start": 2.297, "end": 2.968}, {"text": "100 × 100 ×", "start": 2.968, "end": 6.389}, {"text": "100 = *1* *triệu*.", "start": 6.389, "end": 9.73}], [{"text": "*1677*,", "start": 0.32, "end": 1.414}, {"text": "giọt nước:", "start": 1.414, "end": 1.804}, {"text": "tính ra", "start": 1.804, "end": 2.585}, {"text": "*2* *730* *000*,", "start": 2.585, "end": 6.816}, {"text": "báo *1* *triệu*.", "start": 6.816, "end": 8.76}], [{"text": "Hội Hoàng gia", "start": 0.4, "end": 1.465}, {"text": "*kiểm* *tra* *lại* rồi", "start": 1.465, "end": 3.205}, {"text": "mới *công* *nhận*.", "start": 3.205, "end": 4.39}], [{"text": "Ông *giữ* *kín* cách", "start": 0.4, "end": 2.38}, {"text": "mài kính tốt nhất.", "start": 2.38, "end": 4.74}], [{"text": "Ước chừng bằng mắt,", "start": 0.33, "end": 2.296}, {"text": "nhưng *gần* *số*", "start": 2.296, "end": 3.508}, {"text": "*đo* *hiện* *đại*.", "start": 3.508, "end": 4.84}], [{"text": "Hồng cầu rộng", "start": 0.42, "end": 1.202}, {"text": "khoảng *7* *µm*,", "start": 1.202, "end": 3.506}, {"text": "tức *0,007* *mm*.", "start": 3.506, "end": 6.01}], [{"text": "100 × 7 µm", "start": 0.37, "end": 2.237}, {"text": "= *0,7* *mm*:", "start": 2.237, "end": 3.403}, {"text": "đúng cỡ", "start": 3.403, "end": 4.3}, {"text": "*hạt* *cát* *thô*.", "start": 4.3, "end": 5.12}], [{"text": "1 ml máu có", "start": 0.3, "end": 3.405}, {"text": "*4–6* *tỉ* hồng cầu.", "start": 3.405, "end": 6.83}], [{"text": "*So* với vật quen,", "start": 0.36, "end": 3.635}, {"text": "rồi nhân *lập* *phương*.", "start": 3.635, "end": 7.2}], []]