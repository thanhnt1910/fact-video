[[{"text": "Giọt nước có *1*", "start": 0.37, "end": 2.457}, {"text": "*triệu* sinh vật.", "start": 2.457, "end": 3.835}, {"text": "Làm sao *đếm*", "start": 3.835, "end": 5.782}, {"text": "thứ không thấy?", "start": 5.782, "end": 7.28}], [{"text": "Người đếm là", "start": 0.32, "end": 1.574}, {"text": "*một* *người* *bán* *vải*", "start": 1.574, "end": 3.486}, {"text": "ở Hà Lan.", "start": 3.486, "end": 4.98}], [{"text": "Vì sao đo được?", "start": 0.39, "end": 2.7}, {"text": "Ông dùng *hạt* *cát*.", "start": 2.7, "end": 6.47}], [{"text": "Kính một thấu kính,", "start": 0.42, "end": 2.183}, {"text": "phóng to", "start": 2.183, "end": 3.475}, {"text": "tới *275* *lần*.", "start": 3.475, "end": 6.68}], [{"text": "Thấy chưa đủ:", "start": 0.42, "end": 2.123}, {"text": "phải biết chúng", "start": 2.123, "end": 3.927}, {"text": "*to* *bao* *nhiêu*.", "start": 3.927, "end": 5.47}], [{"text": "So với *hạt* *cát*,", "start": 0.4, "end": 2.16}, {"text": "*hạt* *kê*,", "start": 2.16, "end": 3.745}, {"text": "*sợi* *tóc*.", "start": 3.745, "end": 4.85}], [{"text": "Hạt cát dài gấp", "start": 0.46, "end": 1.86}, {"text": "*12* *lần* con vật.", "start": 1.86, "end": 4.08}], [{"text": "Dài gấp 12", "start": 0.39, "end": 2.536}, {"text": "thì *thể* *tích*", "start": 2.536, "end": 4.154}, {"text": "không gấp 12.", "start": 4.154, "end": 6.97}], [{"text": "*12* *×* *12* *×*", "start": 0.42, "end": 3.968}, {"text": "*12* *=* *1* *728*.", "start": 3.968, "end": 8.14}], [{"text": "Hạt cát lớn", "start": 0.39, "end": 1.23}, {"text": "gấp *1* *728*", "start": 1.23, "end": 3.34}, {"text": "lần con vật.", "start": 3.34, "end": 4.3}], [{"text": "Loại dài bằng *1/4*:", "start": 0.36, "end": 3.074}, {"text": "4 × 4 ×", "start": 3.074, "end": 5.467}, {"text": "4 = *64*.", "start": 5.467, "end": 8.07}], [{"text": "1 728 × 64", "start": 0.46, "end": 3.343}, {"text": "= *110* *592* con", "start": 3.343, "end": 7.041}, {"text": "trong một hạt cát.", "start": 7.041, "end": 8.21}], [{"text": "Loại dài bằng *1/10*:", "start": 0.34, "end": 2.084}, {"text": "nhân thêm 1 000,", "start": 2.084, "end": 4.177}, {"text": "ra hơn", "start": 4.177, "end": 4.845}, {"text": "*110* *triệu* con.", "start": 4.845, "end": 6.29}], [{"text": "*100* hồng cầu dài", "start": 0.33, "end": 2.528}, {"text": "bằng hạt cát:", "start": 2.528, "end": 3.455}, {"text": "100 × 100 ×", "start": 3.455, "end": 7.052}, {"text": "100 = *1* *triệu*.", "start": 7.052, "end": 9.73}], [{"text": "*1677*,", "start": 0.32, "end": 2.498}, {"text": "giọt nước:", "start": 2.498, "end": 3.008}, {"text": "tính ra", "start": 3.008, "end": 3.859}, {"text": "*2* *730* *000*,", "start": 3.859, "end": 7.534}, {"text": "báo *1* *triệu*.", "start": 7.534, "end": 8.76}], [{"text": "Hội Hoàng gia", "start": 0.4, "end": 1.465}, {"text": "*kiểm* *tra* *lại* rồi", "start": 1.465, "end": 3.205}, {"text": "mới *công* *nhận*.", "start": 3.205, "end": 4.39}], [{"text": "Ông *giữ* *kín* cách", "start": 0.4, "end": 2.38}, {"text": "mài kính tốt nhất.", "start": 2.38, "end": 4.74}], [{"text": "Ước chừng bằng mắt,", "start": 0.33, "end": 2.296}, {"text": "nhưng *gần* *số*", "start": 2.296, "end": 3.508}, {"text": "*đo* *hiện* *đại*.", "start": 3.508, "end": 4.84}], [{"text": "Hồng cầu rộng", "start": 0.42, "end": 1.786}, {"text": "khoảng *7* *µm*,", "start": 1.786, "end": 2.672}, {"text": "tức *0,007* *mm*.", "start": 2.672, "end": 6.01}], [{"text": "100 × 7 µm", "start": 0.37, "end": 2.138}, {"text": "= *0,7* *mm*:", "start": 2.138, "end": 3.895}, {"text": "đúng cỡ", "start": 3.895, "end": 4.337}, {"text": "*hạt* *cát* *thô*.", "start": 4.337, "end": 5.12}], [{"text": "1 ml máu có", "start": 0.3, "end": 2.864}, {"text": "*4–6* *tỉ* hồng cầu.", "start": 2.864, "end": 6.83}], [{"text": "*So* với vật quen,", "start": 0.36, "end": 3.635}, {"text": "rồi nhân *lập* *phương*.", "start": 3.635, "end": 7.2}], []]