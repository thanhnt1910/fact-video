[
 [
  {
   "text": "Làm sao biết",
   "start": 0.44,
   "end": 1.188
  },
  {
   "text": "*Mặt* *Trăng* ở",
   "start": 1.188,
   "end": 1.936
  },
  {
   "text": "xa bao nhiêu,",
   "start": 1.936,
   "end": 2.944
  },
  {
   "text": "chính xác",
   "start": 2.944,
   "end": 3.442
  },
  {
   "text": "đến từng *mi-li-mét*?",
   "start": 3.442,
   "end": 4.31
  }
 ],
 [
  {
   "text": "Nhưng ta *không* *thể*",
   "start": 0.4,
   "end": 1.253
  },
  {
   "text": "*căng* một cuộn *thước*",
   "start": 1.253,
   "end": 2.107
  },
  {
   "text": "*dây* từ Trái Đất",
   "start": 2.107,
   "end": 2.96
  },
  {
   "text": "lên tới đó.",
   "start": 2.96,
   "end": 3.72
  }
 ],
 [
  {
   "text": "Hóa ra ta",
   "start": 0.39,
   "end": 0.978
  },
  {
   "text": "chỉ cần *một*",
   "start": 0.978,
   "end": 1.697
  },
  {
   "text": "*tia* *sáng* và *một*",
   "start": 1.697,
   "end": 2.482
  },
  {
   "text": "*chiếc* *đồng* *hồ*.",
   "start": 2.482,
   "end": 3.19
  }
 ],
 [
  {
   "text": "Vậy *tia* *sáng*",
   "start": 0.4,
   "end": 0.994
  },
  {
   "text": "ấy đo *khoảng* *cách*",
   "start": 0.994,
   "end": 1.786
  },
  {
   "text": "bằng cách nào?",
   "start": 1.786,
   "end": 2.5
  }
 ],
 [
  {
   "text": "Người xưa chưa có,",
   "start": 0.35,
   "end": 1.357
  },
  {
   "text": "họ chỉ có *đôi*",
   "start": 1.357,
   "end": 2.633
  },
  {
   "text": "*mắt* và *hình* *học*.",
   "start": 2.633,
   "end": 3.9
  }
 ],
 [
  {
   "text": "Họ cùng nhìn *một*",
   "start": 0.42,
   "end": 1.222
  },
  {
   "text": "*lần* *nhật* *thực*,",
   "start": 1.222,
   "end": 1.914
  },
  {
   "text": "lúc Mặt Trăng",
   "start": 1.914,
   "end": 2.815
  },
  {
   "text": "che Mặt Trời,",
   "start": 2.815,
   "end": 3.417
  },
  {
   "text": "từ *hai* *thành*",
   "start": 3.417,
   "end": 4.278
  },
  {
   "text": "*phố* khác nhau.",
   "start": 4.278,
   "end": 5.0
  }
 ],
 [
  {
   "text": "Ở thành phố này",
   "start": 0.42,
   "end": 1.658
  },
  {
   "text": "bị *che* *hoàn* *toàn*,",
   "start": 1.658,
   "end": 2.655
  },
  {
   "text": "ở thành phố",
   "start": 2.655,
   "end": 3.794
  },
  {
   "text": "kia chỉ bị",
   "start": 3.794,
   "end": 4.782
  },
  {
   "text": "*che* *một* *phần*.",
   "start": 4.782,
   "end": 5.65
  }
 ],
 [
  {
   "text": "Như *ngón*",
   "start": 0.35,
   "end": 0.914
  },
  {
   "text": "*tay* *che* *đèn*:",
   "start": 0.914,
   "end": 1.761
  },
  {
   "text": "đổi chỗ đứng",
   "start": 1.761,
   "end": 3.037
  },
  {
   "text": "thì ngón tay",
   "start": 3.037,
   "end": 4.124
  },
  {
   "text": "*che* *lệch* *đi*.",
   "start": 4.124,
   "end": 5.09
  }
 ],
 [
  {
   "text": "Nhà thiên văn *Hi-pác-cơ*",
   "start": 0.35,
   "end": 1.376
  },
  {
   "text": "dùng *độ* *lệch* ấy",
   "start": 1.376,
   "end": 2.592
  },
  {
   "text": "để vẽ *một* *tam*",
   "start": 2.592,
   "end": 3.618
  },
  {
   "text": "*giác* nối hai thành",
   "start": 3.618,
   "end": 4.754
  },
  {
   "text": "phố với Mặt Trăng.",
   "start": 4.754,
   "end": 5.9
  }
 ],
 [
  {
   "text": "Ông tính ra Mặt",
   "start": 0.36,
   "end": 1.242
  },
  {
   "text": "Trăng xa *60* *đến*",
   "start": 1.242,
   "end": 2.565
  },
  {
   "text": "*70* *lần* quãng",
   "start": 2.565,
   "end": 3.817
  },
  {
   "text": "từ *tâm* *Trái* *Đất*",
   "start": 3.817,
   "end": 4.699
  },
  {
   "text": "ra mặt đất.",
   "start": 4.699,
   "end": 5.48
  }
 ],
 [
  {
   "text": "Đúng cỡ độ lớn,",
   "start": 0.35,
   "end": 1.488
  },
  {
   "text": "nhưng *độ* *lệch* *rất*",
   "start": 1.488,
   "end": 2.895
  },
  {
   "text": "*nhỏ* nên kết quả",
   "start": 2.895,
   "end": 4.263
  },
  {
   "text": "*còn* *dao* *động* nhiều.",
   "start": 4.263,
   "end": 5.52
  }
 ],
 [
  {
   "text": "Muốn *chính* *xác* *hơn*,",
   "start": 0.44,
   "end": 1.66
  },
  {
   "text": "cần cách đo *không*",
   "start": 1.66,
   "end": 2.67
  },
  {
   "text": "*dựa* *vào* *mắt* *nhìn*.",
   "start": 2.67,
   "end": 3.8
  }
 ],
 [
  {
   "text": "Ánh sáng",
   "start": 0.38,
   "end": 0.857
  },
  {
   "text": "chạy rất đều,",
   "start": 0.857,
   "end": 1.347
  },
  {
   "text": "mỗi giây đi *khoảng*",
   "start": 1.347,
   "end": 2.251
  },
  {
   "text": "*300* *000* *km*.",
   "start": 2.251,
   "end": 4.17
  }
 ],
 [
  {
   "text": "Muốn biết *quãng* *đường*,",
   "start": 0.42,
   "end": 1.706
  },
  {
   "text": "chỉ cần biết",
   "start": 1.706,
   "end": 2.795
  },
  {
   "text": "ánh sáng đã chạy",
   "start": 2.795,
   "end": 4.141
  },
  {
   "text": "*trong* *bao* *lâu*.",
   "start": 4.141,
   "end": 5.06
  }
 ],
 [
  {
   "text": "Như *ném* *bóng* *vào*",
   "start": 0.25,
   "end": 1.104
  },
  {
   "text": "*tường* rồi bắt lại:",
   "start": 1.104,
   "end": 1.958
  },
  {
   "text": "thời gian *đi* *và*",
   "start": 1.958,
   "end": 3.232
  },
  {
   "text": "*về* *chia* *đôi* là",
   "start": 3.232,
   "end": 4.246
  },
  {
   "text": "thời gian *một* *chiều*.",
   "start": 4.246,
   "end": 5.22
  }
 ],
 [
  {
   "text": "*Khoảng* *cách* =",
   "start": 0.38,
   "end": 1.143
  },
  {
   "text": "*tốc* *độ* × *thời*",
   "start": 1.143,
   "end": 2.249
  },
  {
   "text": "*gian* ÷ 2,",
   "start": 2.249,
   "end": 3.456
  },
  {
   "text": "vì ánh sáng *đi*",
   "start": 3.456,
   "end": 4.773
  },
  {
   "text": "*cả* *đi* *lẫn* *về*.",
   "start": 4.773,
   "end": 5.91
  }
 ],
 [
  {
   "text": "Năm *1969*,",
   "start": 0.38,
   "end": 2.013
  },
  {
   "text": "đoàn *Apollo* *11*",
   "start": 2.013,
   "end": 3.921
  },
  {
   "text": "đặt lên Mặt Trăng",
   "start": 3.921,
   "end": 4.738
  },
  {
   "text": "*một* *tấm* *gương*.",
   "start": 4.738,
   "end": 5.6
  }
 ],
 [
  {
   "text": "Giống *miếng* *phản*",
   "start": 0.47,
   "end": 1.185
  },
  {
   "text": "*quang* xe đạp:",
   "start": 1.185,
   "end": 1.899
  },
  {
   "text": "ánh sáng chiếu vào",
   "start": 1.899,
   "end": 3.272
  },
  {
   "text": "*bật* *thẳng* *trở* *lại*",
   "start": 3.272,
   "end": 4.425
  },
  {
   "text": "nơi phát ra.",
   "start": 4.425,
   "end": 5.26
  }
 ],
 [
  {
   "text": "Tháng 8,",
   "start": 0.43,
   "end": 1.093
  },
  {
   "text": "đài thiên văn *Lick*",
   "start": 1.093,
   "end": 2.267
  },
  {
   "text": "ở California bắn",
   "start": 2.267,
   "end": 3.592
  },
  {
   "text": "*một* *xung* *laser* về",
   "start": 3.592,
   "end": 5.057
  },
  {
   "text": "phía tấm gương.",
   "start": 5.057,
   "end": 5.84
  }
 ],
 [
  {
   "text": "Xung có *hơn*",
   "start": 0.44,
   "end": 1.146
  },
  {
   "text": "*1* *000* *tỉ*",
   "start": 1.146,
   "end": 2.793
  },
  {
   "text": "*hạt* ánh sáng,",
   "start": 2.793,
   "end": 3.838
  },
  {
   "text": "nhưng chỉ *vài*",
   "start": 3.838,
   "end": 4.544
  },
  {
   "text": "*hạt* quay về.",
   "start": 4.544,
   "end": 5.37
  }
 ],
 [
  {
   "text": "Bấm giờ từ",
   "start": 0.36,
   "end": 1.14
  },
  {
   "text": "lúc bắn đến",
   "start": 1.14,
   "end": 2.35
  },
  {
   "text": "lúc nhận lại:",
   "start": 2.35,
   "end": 3.47
  },
  {
   "text": "khoảng *2,5* *giây*.",
   "start": 3.47,
   "end": 5.15
  }
 ],
 [
  {
   "text": "Quãng đường",
   "start": 0.33,
   "end": 0.806
  },
  {
   "text": "đi và về:",
   "start": 0.806,
   "end": 1.82
  },
  {
   "text": "*300* *000* *×* *2,5*.",
   "start": 1.82,
   "end": 6.31
  }
 ],
 [
  {
   "text": "= *750* *000* *km*.",
   "start": 0.28,
   "end": 2.63
  }
 ],
 [
  {
   "text": "Gồm *đường* *đi*",
   "start": 0.33,
   "end": 1.173
  },
  {
   "text": "và *đường* *về*,",
   "start": 1.173,
   "end": 2.016
  },
  {
   "text": "nên ta *chia* *đôi*.",
   "start": 2.016,
   "end": 3.6
  }
 ],
 [
  {
   "text": "*750* *000* *÷* *2*",
   "start": 0.38,
   "end": 2.475
  },
  {
   "text": "= *375* *000* *km*.",
   "start": 2.475,
   "end": 4.39
  }
 ],
 [
  {
   "text": "Số thật trung bình:",
   "start": 0.42,
   "end": 1.449
  },
  {
   "text": "*384* *400* *km*.",
   "start": 1.449,
   "end": 4.4
  }
 ],
 [
  {
   "text": "Ta *lệch*",
   "start": 0.35,
   "end": 0.73
  },
  {
   "text": "*chưa* *tới* *3%*,",
   "start": 0.73,
   "end": 1.87
  },
  {
   "text": "vì đã *làm*",
   "start": 1.87,
   "end": 2.63
  },
  {
   "text": "*tròn* thời gian",
   "start": 2.63,
   "end": 3.2
  },
  {
   "text": "và tốc độ.",
   "start": 3.2,
   "end": 3.89
  }
 ],
 [
  {
   "text": "Đo thời gian",
   "start": 0.31,
   "end": 1.507
  },
  {
   "text": "*kỹ* *hơn* *nhiều*,",
   "start": 1.507,
   "end": 3.015
  },
  {
   "text": "nên chính",
   "start": 3.015,
   "end": 3.813
  },
  {
   "text": "xác đến *mi-li-mét*.",
   "start": 3.813,
   "end": 5.22
  }
 ],
 [
  {
   "text": "*1* *mi-li-mét* chỉ",
   "start": 0.38,
   "end": 1.18
  },
  {
   "text": "bằng độ dày khoảng",
   "start": 1.18,
   "end": 2.533
  },
  {
   "text": "*10* *tờ* *giấy*.",
   "start": 2.533,
   "end": 3.82
  }
 ],
 [
  {
   "text": "Nhờ vậy biết Mặt",
   "start": 0.35,
   "end": 1.731
  },
  {
   "text": "Trăng *xa* *thêm* khoảng",
   "start": 1.731,
   "end": 3.081
  },
  {
   "text": "*3,8* *xen-ti-mét* mỗi năm.",
   "start": 3.081,
   "end": 5.46
  }
 ],
 [
  {
   "text": "Vậy ta biết nhờ",
   "start": 0.42,
   "end": 1.754
  },
  {
   "text": "đo *thời* *gian*",
   "start": 1.754,
   "end": 2.845
  },
  {
   "text": "một *tia* *sáng* đi",
   "start": 2.845,
   "end": 4.179
  },
  {
   "text": "rồi quay về.",
   "start": 4.179,
   "end": 5.39
  }
 ]
]