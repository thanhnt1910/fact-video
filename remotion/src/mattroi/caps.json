[
 [
  {
   "text": "Làm sao biết *Mặt*",
   "start": 0.31,
   "end": 1.352
  },
  {
   "text": "*Trời* xa hơn *Mặt*",
   "start": 1.352,
   "end": 2.194
  },
  {
   "text": "*Trăng* bao nhiêu lần,",
   "start": 2.194,
   "end": 3.036
  },
  {
   "text": "khi chưa có",
   "start": 3.036,
   "end": 4.027
  },
  {
   "text": "cây thước nào",
   "start": 4.027,
   "end": 4.659
  },
  {
   "text": "dài tới thế?",
   "start": 4.659,
   "end": 5.41
  }
 ],
 [
  {
   "text": "Nhưng cách đây hơn",
   "start": 0.4,
   "end": 1.206
  },
  {
   "text": "*2* *000* *năm*,",
   "start": 1.206,
   "end": 3.087
  },
  {
   "text": "người Hy Lạp A-ri-xta-khơ",
   "start": 3.087,
   "end": 4.153
  },
  {
   "text": "chỉ cần ngắm Mặt",
   "start": 4.153,
   "end": 4.959
  },
  {
   "text": "Trăng lúc nó *sáng*",
   "start": 4.959,
   "end": 6.035
  },
  {
   "text": "*đúng* *một* *nửa*.",
   "start": 6.035,
   "end": 6.76
  }
 ],
 [
  {
   "text": "Hóa ra khoảnh",
   "start": 0.4,
   "end": 0.986
  },
  {
   "text": "khắc ấy giấu một",
   "start": 0.986,
   "end": 1.768
  },
  {
   "text": "*hình* *tam* *giác*,",
   "start": 1.768,
   "end": 2.355
  },
  {
   "text": "và từ hình",
   "start": 2.355,
   "end": 3.452
  },
  {
   "text": "ấy ông tính được",
   "start": 3.452,
   "end": 4.424
  },
  {
   "text": "cả *khoảng* *cách*.",
   "start": 4.424,
   "end": 5.13
  }
 ],
 [
  {
   "text": "Vì sao một Mặt",
   "start": 0.4,
   "end": 1.323
  },
  {
   "text": "Trăng sáng một nửa",
   "start": 1.323,
   "end": 2.247
  },
  {
   "text": "lại là *manh* *mối*?",
   "start": 2.247,
   "end": 3.47
  }
 ],
 [
  {
   "text": "Vì Mặt Trăng *tự*",
   "start": 0.34,
   "end": 1.24
  },
  {
   "text": "*nó* *không* *sáng*,",
   "start": 1.24,
   "end": 1.915
  },
  {
   "text": "chỉ nửa mặt hướng",
   "start": 1.915,
   "end": 3.125
  },
  {
   "text": "về *Mặt* *Trời* là",
   "start": 3.125,
   "end": 4.025
  },
  {
   "text": "được chiếu sáng.",
   "start": 4.025,
   "end": 4.82
  }
 ],
 [
  {
   "text": "*Giống* *như* quả bóng",
   "start": 0.38,
   "end": 1.287
  },
  {
   "text": "trong phòng tối:",
   "start": 1.287,
   "end": 2.387
  },
  {
   "text": "đèn pin chỉ rọi",
   "start": 2.387,
   "end": 3.293
  },
  {
   "text": "sáng *một* *nửa* quả.",
   "start": 3.293,
   "end": 4.32
  }
 ],
 [
  {
   "text": "Khi ta thấy đúng",
   "start": 0.39,
   "end": 1.198
  },
  {
   "text": "nửa quả sáng,",
   "start": 1.198,
   "end": 1.803
  },
  {
   "text": "mắt ta đang",
   "start": 1.803,
   "end": 2.699
  },
  {
   "text": "nhìn *vuông* *góc*",
   "start": 2.699,
   "end": 3.304
  },
  {
   "text": "với tia đèn.",
   "start": 3.304,
   "end": 4.03
  }
 ],
 [
  {
   "text": "Với Mặt",
   "start": 0.47,
   "end": 0.935
  },
  {
   "text": "Trăng cũng vậy,",
   "start": 0.935,
   "end": 1.763
  },
  {
   "text": "lúc ấy *Trái* *Đất*,",
   "start": 1.763,
   "end": 2.693
  },
  {
   "text": "*Mặt* *Trăng* và *Mặt*",
   "start": 2.693,
   "end": 3.882
  },
  {
   "text": "*Trời* tạo thành một",
   "start": 3.882,
   "end": 4.943
  },
  {
   "text": "hình tam giác.",
   "start": 4.943,
   "end": 5.76
  }
 ],
 [
  {
   "text": "Và *góc* *vuông* của",
   "start": 0.36,
   "end": 1.244
  },
  {
   "text": "tam giác nằm đúng",
   "start": 1.244,
   "end": 2.127
  },
  {
   "text": "ở *Mặt* *Trăng*.",
   "start": 2.127,
   "end": 2.91
  }
 ],
 [
  {
   "text": "Vậy chỉ còn",
   "start": 0.39,
   "end": 1.058
  },
  {
   "text": "phải biết *góc*",
   "start": 1.058,
   "end": 1.726
  },
  {
   "text": "*ở* *Trái* *Đất*,",
   "start": 1.726,
   "end": 2.714
  },
  {
   "text": "giữa hướng nhìn",
   "start": 2.714,
   "end": 3.382
  },
  {
   "text": "Mặt Trăng và hướng",
   "start": 3.382,
   "end": 4.372
  },
  {
   "text": "nhìn Mặt Trời.",
   "start": 4.372,
   "end": 5.16
  }
 ],
 [
  {
   "text": "A-ri-xta-khơ cho rằng góc",
   "start": 0.39,
   "end": 1.325
  },
  {
   "text": "ấy là *87°*,",
   "start": 1.325,
   "end": 3.088
  },
  {
   "text": "chỉ kém góc",
   "start": 3.088,
   "end": 4.039
  },
  {
   "text": "vuông một chút.",
   "start": 4.039,
   "end": 4.95
  }
 ],
 [
  {
   "text": "Từ góc ấy",
   "start": 0.43,
   "end": 1.187
  },
  {
   "text": "có công thức:",
   "start": 1.187,
   "end": 2.344
  },
  {
   "text": "*số* *lần* *xa* =",
   "start": 2.344,
   "end": 3.803
  },
  {
   "text": "*1* *÷* *cos(góc)*.",
   "start": 3.803,
   "end": 4.68
  }
 ],
 [
  {
   "text": "*Cô-sin* là một",
   "start": 0.34,
   "end": 1.0
  },
  {
   "text": "con số máy",
   "start": 1.0,
   "end": 1.66
  },
  {
   "text": "tính bấm ra;",
   "start": 1.66,
   "end": 2.32
  },
  {
   "text": "góc càng gần",
   "start": 2.32,
   "end": 3.35
  },
  {
   "text": "*90°* thì số",
   "start": 3.35,
   "end": 4.68
  },
  {
   "text": "này càng nhỏ.",
   "start": 4.68,
   "end": 5.46
  }
 ],
 [
  {
   "text": "Với *87°*,",
   "start": 0.41,
   "end": 1.683
  },
  {
   "text": "máy tính cho",
   "start": 1.683,
   "end": 2.285
  },
  {
   "text": "cô-sin khoảng *0,052*.",
   "start": 2.285,
   "end": 4.21
  }
 ],
 [
  {
   "text": "Rồi *1* *÷*",
   "start": 0.52,
   "end": 1.721
  },
  {
   "text": "*0,052* ≈ *19*.",
   "start": 1.721,
   "end": 4.66
  }
 ],
 [
  {
   "text": "Vậy theo A-ri-xta-khơ,",
   "start": 0.35,
   "end": 1.141
  },
  {
   "text": "Mặt Trời xa",
   "start": 1.141,
   "end": 2.241
  },
  {
   "text": "hơn Mặt Trăng",
   "start": 2.241,
   "end": 3.032
  },
  {
   "text": "khoảng *19* *lần*.",
   "start": 3.032,
   "end": 4.47
  }
 ],
 [
  {
   "text": "Nhưng *con* *số*",
   "start": 0.33,
   "end": 1.043
  },
  {
   "text": "*thật* lớn hơn",
   "start": 1.043,
   "end": 1.967
  },
  {
   "text": "thế rất nhiều.",
   "start": 1.967,
   "end": 2.8
  }
 ],
 [
  {
   "text": "Vì góc thật",
   "start": 0.43,
   "end": 1.173
  },
  {
   "text": "gần như *vuông*,",
   "start": 1.173,
   "end": 1.916
  },
  {
   "text": "chỉ hơn góc ông",
   "start": 1.916,
   "end": 3.157
  },
  {
   "text": "tính chừng *3°*.",
   "start": 3.157,
   "end": 4.02
  }
 ],
 [
  {
   "text": "*Ví* *dụ*,",
   "start": 0.37,
   "end": 0.729
  },
  {
   "text": "ngắm một cột đèn",
   "start": 0.729,
   "end": 1.667
  },
  {
   "text": "xa *100* *m*:",
   "start": 1.667,
   "end": 3.484
  },
  {
   "text": "lệch *3°* thì",
   "start": 3.484,
   "end": 4.273
  },
  {
   "text": "điểm ngắm đã trượt",
   "start": 4.273,
   "end": 4.991
  },
  {
   "text": "hơn *5* *m*.",
   "start": 4.991,
   "end": 5.65
  }
 ],
 [
  {
   "text": "Gần góc vuông,",
   "start": 0.37,
   "end": 1.131
  },
  {
   "text": "cô-sin *nhỏ* *xíu*,",
   "start": 1.131,
   "end": 2.182
  },
  {
   "text": "nên chia cho nó",
   "start": 2.182,
   "end": 3.506
  },
  {
   "text": "thì một chút lệch",
   "start": 3.506,
   "end": 4.521
  },
  {
   "text": "cũng làm *kết* *quả*",
   "start": 4.521,
   "end": 5.715
  },
  {
   "text": "*vọt* *lên* rất xa.",
   "start": 5.715,
   "end": 6.85
  }
 ],
 [
  {
   "text": "Thật vậy,",
   "start": 0.44,
   "end": 0.736
  },
  {
   "text": "với góc thật,",
   "start": 0.736,
   "end": 1.46
  },
  {
   "text": "phép chia *1*",
   "start": 1.46,
   "end": 2.334
  },
  {
   "text": "*÷* *cos(89,85°)* cho ra",
   "start": 2.334,
   "end": 3.814
  },
  {
   "text": "khoảng *390* *lần*.",
   "start": 3.814,
   "end": 4.97
  }
 ],
 [
  {
   "text": "Góc thật chỉ",
   "start": 0.38,
   "end": 1.163
  },
  {
   "text": "kém *90°* chưa",
   "start": 1.163,
   "end": 2.678
  },
  {
   "text": "tới *1/6* *độ*,",
   "start": 2.678,
   "end": 3.933
  },
  {
   "text": "điều thời ấy không",
   "start": 3.933,
   "end": 5.217
  },
  {
   "text": "ai đo nổi.",
   "start": 5.217,
   "end": 6.03
  }
 ],
 [
  {
   "text": "Vậy *cách* *làm* của",
   "start": 0.43,
   "end": 1.345
  },
  {
   "text": "ông hoàn toàn đúng,",
   "start": 1.345,
   "end": 2.259
  },
  {
   "text": "chỉ có *con* *số*",
   "start": 2.259,
   "end": 3.494
  },
  {
   "text": "*góc* là lệch.",
   "start": 3.494,
   "end": 4.39
  }
 ],
 [
  {
   "text": "Nhờ đó,",
   "start": 0.16,
   "end": 0.65
  },
  {
   "text": "chỉ bằng *đôi* *mắt*",
   "start": 0.65,
   "end": 1.631
  },
  {
   "text": "và *hình* *học*,",
   "start": 1.631,
   "end": 2.367
  },
  {
   "text": "ông đã thấy Mặt",
   "start": 2.367,
   "end": 3.348
  },
  {
   "text": "Trời xa hơn Mặt",
   "start": 3.348,
   "end": 4.329
  },
  {
   "text": "Trăng *rất* *nhiều* *lần*.",
   "start": 4.329,
   "end": 5.56
  }
 ],
 [
  {
   "text": "Vậy muốn biết Mặt",
   "start": 0.47,
   "end": 1.346
  },
  {
   "text": "Trời xa gấp mấy",
   "start": 1.346,
   "end": 2.223
  },
  {
   "text": "lần Mặt Trăng,",
   "start": 2.223,
   "end": 2.88
  },
  {
   "text": "ta *nhìn* *Mặt* *Trăng*",
   "start": 2.88,
   "end": 4.086
  },
  {
   "text": "lúc sáng một nửa,",
   "start": 4.086,
   "end": 4.963
  },
  {
   "text": "rồi *đo* *góc*.",
   "start": 4.963,
   "end": 5.99
  }
 ]
]