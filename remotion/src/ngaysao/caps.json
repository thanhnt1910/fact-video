[
 [
  {
   "text": "Trái Đất quay",
   "start": 0.43,
   "end": 1.058
  },
  {
   "text": "*đúng* *một* *vòng*",
   "start": 1.058,
   "end": 1.686
  },
  {
   "text": "mất bao lâu,",
   "start": 1.686,
   "end": 2.314
  },
  {
   "text": "có phải",
   "start": 2.314,
   "end": 3.133
  },
  {
   "text": "*24* *giờ* không?",
   "start": 3.133,
   "end": 4.3
  }
 ],
 [
  {
   "text": "Nhưng thật ra,",
   "start": 0.36,
   "end": 1.362
  },
  {
   "text": "nó quay xong *sớm*",
   "start": 1.362,
   "end": 2.551
  },
  {
   "text": "*hơn* *khoảng* *4* *phút*.",
   "start": 2.551,
   "end": 3.86
  }
 ],
 [
  {
   "text": "*4* *phút* ấy",
   "start": 0.46,
   "end": 1.262
  },
  {
   "text": "từ đâu ra,",
   "start": 1.262,
   "end": 2.415
