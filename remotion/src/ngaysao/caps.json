  {
   "text": "và đồng hồ",
   "start": 1.868,
   "end": 2.702
  },
  {
   "text": "của ta dùng",
   "start": 2.702,
   "end": 3.426
  },
  {
   "text": "*con* *số* *này*.",
   "start": 3.426,
   "end": 4.27
  }
 ],
 [
  {
   "text": "Cách hai:",
   "start": 0.4,
