  {
   "text": "nhìn *một* *ngôi*",
   "start": 0.945,
   "end": 2.012
  },
  {
   "text": "*sao* *rất* *xa*.",
   "start": 2.012,
   "end": 2.95
  }
 ],
 [
  {
   "text": "Rồi đo tới",
   "start": 0.31,
   "end": 1.294
  },
  {
   "text": "lúc nó *trở* *lại*",
   "start": 1.294,
   "end": 2.956
  },
  {
   "text": "*đúng* *chỗ* *cũ*.",
   "start": 2.956,
   "end": 4.06
  }
 ],
 [
  {
   "text": "Sao rất xa nên",
