   "end": 3.279
  },
  {
   "text": "tới *giữa*",
   "start": 3.279,
   "end": 3.804
  },
  {
   "text": "*trời* hôm sau.",
   "start": 3.804,
   "end": 4.71
  }
 ],
 [
  {
   "text": "Trung bình *24* *giờ*,",
