   "text": "Mặt Trời *chưa*",
   "start": 1.655,
   "end": 2.891
  },
  {
   "text": "*về* *giữa* *trời*,",
   "start": 2.891,
   "end": 4.218
  },
  {
   "text": "phải quay thêm",
   "start": 4.218,
   "end": 5.204
