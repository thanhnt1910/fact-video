  {
   "text": "và vì sao",
   "start": 2.415,
   "end": 3.218
  },
  {
   "text": "*ngày* *dài* *hơn*?",
   "start": 3.218,
   "end": 4.14
  }
 ],
 [
  {
   "text": "Có *hai* *cách*",
   "start": 0.55,
   "end": 1.36
  },
  {
   "text": "*đo* một ngày,",
   "start": 1.36,
   "end": 2.51
  },
  {
