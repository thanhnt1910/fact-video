  {
   "text": "hơn *4* *phút*,",
   "start": 1.189,
   "end": 1.959
  },
  {
   "text": "vì Trái Đất còn",
   "start": 1.959,
   "end": 3.114
  },
  {
   "text": "*đi* *quanh* *Mặt* *Trời*.",
   "start": 3.114,
   "end": 4.26
  }
 ]
]