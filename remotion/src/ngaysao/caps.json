  {
   "text": "*nhìn* *Mặt* *Trời*.",
   "start": 3.32,
   "end": 4.34
  }
 ],
 [
  {
   "text": "Đo từ lúc",
   "start": 0.53,
   "end": 1.316
  },
  {
   "text": "Mặt Trời *giữa*",
   "start": 1.316,
   "end": 2.103
  },
  {
   "text": "*trời* hôm nay,",
