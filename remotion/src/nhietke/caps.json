[
 [
  {
   "text": "Hôm nay *nóng*",
   "start": 0.36,
   "end": 0.981
  },
  {
   "text": "*bao* *nhiêu* *độ*?",
   "start": 0.981,
   "end": 1.602
  },
  {
   "text": "Nghe thì dễ,",
   "start": 1.602,
   "end": 2.784
  },
  {
   "text": "nhưng ngày xưa hai",
   "start": 2.784,
   "end": 3.882
  },
  {
   "text": "người đo cùng một",
   "start": 3.882,
   "end": 5.06
  },
  {
   "text": "chỗ lại ra *2*",
   "start": 5.06,
   "end": 6.069
  },
  {
   "text": "*số* *khác* *nhau*.",
   "start": 6.069,
   "end": 6.81
  }
 ],
 [
  {
   "text": "Vì sao một",
   "start": 0.42,
   "end": 1.025
  },
  {
   "text": "cái *nhiệt* *kế*",
   "start": 1.025,
   "end": 1.629
  },
  {
   "text": "lại có thể nói",
   "start": 1.629,
   "end": 2.435
  },
  {
   "text": "sai như vậy?",
   "start": 2.435,
   "end": 3.16
  }
 ],
 [
  {
   "text": "Hóa ra nhiệt kế",
   "start": 0.4,
   "end": 1.525
  },
  {
   "text": "*đã* *có* *từ* *lâu*,",
   "start": 1.525,
   "end": 2.791
  },
  {
   "text": "nhưng mỗi người",
   "start": 2.791,
   "end": 3.447
  },
  {
   "text": "làm *vạch* *chia*",
   "start": 3.447,
   "end": 4.104
  },
  {
   "text": "theo ý riêng.",
   "start": 4.104,
   "end": 4.88
  }
 ],
 [
  {
   "text": "Có người chọn lúc",
   "start": 0.4,
   "end": 1.31
  },
  {
   "text": "*bơ* *tan* làm mốc,",
   "start": 1.31,
   "end": 2.22
  },
  {
   "text": "có người chọn",
   "start": 2.22,
   "end": 3.302
  },
  {
   "text": "lúc *than* *cháy*,",
   "start": 3.302,
   "end": 4.135
  },
  {
   "text": "có người chọn",
   "start": 4.135,
   "end": 5.208
  },
  {
   "text": "*ngày* *lạnh* *nhất*.",
   "start": 5.208,
   "end": 6.11
  }
 ],
 [
  {
   "text": "Nhiệt kế chạy",
   "start": 0.34,
   "end": 1.011
  },
  {
   "text": "nhờ *chất* *lỏng* *nở*",
   "start": 1.011,
   "end": 1.905
  },
  {
   "text": "*ra* khi nóng,",
   "start": 1.905,
   "end": 2.725
  },
  {
   "text": "nên cột chất lỏng",
   "start": 2.725,
   "end": 3.619
  },
  {
   "text": "*dâng* *cao* hơn.",
   "start": 3.619,
   "end": 4.41
  }
 ],
 [
  {
   "text": "*Giống* *như* cột nước",
   "start": 0.32,
   "end": 1.2
  },
  {
   "text": "trong ống nhỏ:",
   "start": 1.2,
   "end": 2.2
  },
  {
   "text": "ấm lên thì *dâng*,",
   "start": 2.2,
   "end": 3.22
  },
  {
   "text": "lạnh đi thì *tụt*.",
   "start": 3.22,
   "end": 4.22
  }
 ],
 [
  {
   "text": "Nhưng dâng tới",
   "start": 0.34,
   "end": 0.932
  },
  {
   "text": "đâu thì gọi là",
   "start": 0.932,
   "end": 1.722
  },
  {
   "text": "*bao* *nhiêu* *độ*?",
   "start": 1.722,
   "end": 2.524
  },
  {
   "text": "Không có *mốc*",
   "start": 2.524,
   "end": 3.116
  },
  {
   "text": "*chung* thì con",
   "start": 3.116,
   "end": 3.708
  },
  {
   "text": "số vô nghĩa.",
   "start": 3.708,
   "end": 4.42
  }
 ],
 [
  {
   "text": "Vậy cần *2*",
   "start": 0.35,
   "end": 1.004
  },
  {
   "text": "*mốc* mà ai cũng",
   "start": 1.004,
   "end": 2.216
  },
  {
   "text": "làm lại được.",
   "start": 2.216,
   "end": 2.99
  }
 ],
 [
  {
   "text": "Năm *1714*,",
   "start": 0.42,
   "end": 2.368
  },
  {
   "text": "Pha-ren-hai,",
   "start": 2.368,
   "end": 2.986
  },
  {
   "text": "*28* *tuổi*,",
   "start": 2.986,
   "end": 3.95
  },
  {
   "text": "làm được *2*",
   "start": 3.95,
   "end": 4.708
  },
  {
   "text": "*nhiệt* *kế* cho cùng",
   "start": 4.708,
   "end": 5.652
  },
  {
   "text": "một số đo.",
   "start": 5.652,
   "end": 6.39
  }
 ],
 [
  {
   "text": "Bí quyết là",
   "start": 0.43,
   "end": 1.058
  },
  {
   "text": "ông dùng những",
   "start": 1.058,
   "end": 1.595
  },
  {
   "text": "*mốc* *cố* *định* thay",
   "start": 1.595,
   "end": 2.712
  },
  {
   "text": "vì tùy ý.",
   "start": 2.712,
   "end": 3.67
  }
 ],
 [
  {
   "text": "Trên thang của ông,",
   "start": 0.37,
   "end": 1.348
  },
  {
   "text": "nước *đóng* *băng*",
   "start": 1.348,
   "end": 2.141
  },
  {
   "text": "ở *32°* và nước",
   "start": 2.141,
   "end": 3.688
  },
  {
   "text": "*sôi* ở *212°*.",
   "start": 3.688,
   "end": 5.63
  }
 ],
 [
  {
   "text": "Hai mốc ấy cách",
   "start": 0.42,
   "end": 1.239
  },
  {
   "text": "nhau *212* *−* *32*",
   "start": 1.239,
   "end": 3.287
  },
  {
   "text": "= *180* độ.",
   "start": 3.287,
   "end": 4.84
  }
 ],
 [
  {
   "text": "Năm *1742*,",
   "start": 0.34,
   "end": 2.302
  },
  {
   "text": "Xen-xi-út cũng chọn *nước*",
   "start": 2.302,
   "end": 3.253
  },
  {
   "text": "*đá* và *nước* *sôi*",
   "start": 3.253,
   "end": 4.114
  },
  {
   "text": "làm hai mốc.",
   "start": 4.114,
   "end": 4.88
  }
 ],
 [
  {
   "text": "Nhưng ông chia khoảng",
   "start": 0.46,
   "end": 1.24
  },
  {
   "text": "giữa thành *100* *phần*,",
   "start": 1.24,
   "end": 2.9
  },
  {
   "text": "thay vì *180* *phần*.",
   "start": 2.9,
   "end": 4.86
  }
 ],
 [
  {
   "text": "Điều lạ là",
   "start": 0.36,
   "end": 0.923
  },
  {
   "text": "thang đầu tiên của",
   "start": 0.923,
   "end": 1.762
  },
  {
   "text": "ông bị *ngược*:",
   "start": 1.762,
   "end": 2.325
  },
  {
   "text": "nước sôi là *0°*,",
   "start": 2.325,
   "end": 3.702
  },
  {
   "text": "nước đóng",
   "start": 3.702,
   "end": 4.358
  },
  {
   "text": "băng là *100°*.",
   "start": 4.358,
   "end": 5.88
  }
 ],
 [
  {
   "text": "Về sau người ta",
   "start": 0.45,
   "end": 1.109
  },
  {
   "text": "*lật* *lại* thang ấy:",
   "start": 1.109,
   "end": 1.768
  },
  {
   "text": "nay nước đóng",
   "start": 1.768,
   "end": 2.553
  },
  {
   "text": "băng là *0°*,",
   "start": 2.553,
   "end": 3.212
  },
  {
   "text": "nước sôi là *100°*.",
   "start": 3.212,
   "end": 5.02
  }
 ],
 [
  {
   "text": "*Nước* *sôi* còn",
   "start": 0.43,
   "end": 1.101
  },
  {
   "text": "khác nhau tùy *áp*",
   "start": 1.101,
   "end": 1.996
  },
  {
   "text": "*suất* *không* *khí*,",
   "start": 1.996,
   "end": 2.667
  },
  {
   "text": "nên ông phải",
   "start": 2.667,
   "end": 3.658
  },
  {
   "text": "đo ở áp",
   "start": 3.658,
   "end": 4.329
  },
  {
   "text": "suất *nhất* *định*.",
   "start": 4.329,
   "end": 5.49
  }
 ],
 [
  {
   "text": "Giờ có *2* *thang*,",
   "start": 0.37,
   "end": 1.172
  },
  {
   "text": "làm sao",
   "start": 1.172,
   "end": 1.774
  },
  {
   "text": "*đổi* *qua* *lại*?",
   "start": 1.774,
   "end": 2.375
  },
  {
   "text": "Cứ so *2* *khoảng*",
   "start": 2.375,
   "end": 3.678
  },
  {
   "text": "*cách* giữa hai mốc.",
   "start": 3.678,
   "end": 4.6
  }
 ],
 [
  {
   "text": "*180* *÷*",
   "start": 0.43,
   "end": 1.338
  },
  {
   "text": "*100* = *1,8*.",
   "start": 1.338,
   "end": 3.14
  }
 ],
 [
  {
   "text": "Nên *1* *độ*",
   "start": 0.29,
   "end": 0.97
  },
  {
   "text": "*C* dài bằng",
   "start": 0.97,
   "end": 1.83
  },
  {
   "text": "*1,8* *độ* *F*.",
   "start": 1.83,
   "end": 3.31
  }
 ],
 [
  {
   "text": "*1,8* chính là *9/5*.",
   "start": 0.36,
   "end": 2.61
  }
 ],
 [
  {
   "text": "Vậy công",
   "start": 0.35,
   "end": 0.846
  },
  {
   "text": "thức đổi là:",
   "start": 0.846,
   "end": 1.969
  },
  {
   "text": "*độ* *F* = *độ*",
   "start": 1.969,
   "end": 3.23
  },
  {
   "text": "*C* *×* *9* *÷*",
   "start": 3.23,
   "end": 4.431
  },
  {
   "text": "*5* *+* *32*.",
   "start": 4.431,
   "end": 6.0
  }
 ],
 [
  {
   "text": "Ta cộng *32* vì",
   "start": 0.47,
   "end": 1.848
  },
  {
   "text": "thang của Pha-ren-hai bắt",
   "start": 1.848,
   "end": 3.045
  },
  {
   "text": "đầu thấp hơn:",
   "start": 3.045,
   "end": 3.644
  },
  {
   "text": "nước đá đã là",
   "start": 3.644,
   "end": 4.842
  },
  {
   "text": "*32* *độ* *F*.",
   "start": 4.842,
   "end": 5.96
  }
 ],
 [
  {
   "text": "*Ví* *dụ*,",
   "start": 0.49,
   "end": 0.91
  },
  {
   "text": "một ngày",
   "start": 0.91,
   "end": 1.33
  },
  {
   "text": "*25* *độ* *C*.",
   "start": 1.33,
   "end": 2.61
  }
 ],
 [
  {
   "text": "*25* *×*",
   "start": 0.53,
   "end": 1.37
  },
  {
   "text": "*9* = *225*.",
   "start": 1.37,
   "end": 2.96
  }
 ],
 [
  {
   "text": "*225* *÷*",
   "start": 0.38,
   "end": 1.82
  },
  {
   "text": "*5* = *45*.",
   "start": 1.82,
   "end": 3.23
  }
 ],
 [
  {
   "text": "Rồi *45* *+* *32*",
   "start": 0.33,
   "end": 1.769
  },
  {
   "text": "= *77* *độ* *F*.",
   "start": 1.769,
   "end": 3.23
  }
 ],
 [
  {
   "text": "Vậy hai người",
   "start": 0.42,
   "end": 1.122
  },
  {
   "text": "đo ra *2*",
   "start": 1.122,
   "end": 1.823
  },
  {
   "text": "*số* *khác* *nhau* vì",
   "start": 1.823,
   "end": 2.758
  },
  {
   "text": "thiếu *mốc* *chung*.",
   "start": 2.758,
   "end": 3.58
  }
 ],
 [
  {
   "text": "Có *2* *mốc* *chung*",
   "start": 0.29,
   "end": 1.153
  },
  {
   "text": "thì mọi nhiệt kế",
   "start": 1.153,
   "end": 2.267
  },
  {
   "text": "nói *cùng* *một* *điều*.",
   "start": 2.267,
   "end": 3.25
  }
 ]
]