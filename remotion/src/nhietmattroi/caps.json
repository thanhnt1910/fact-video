[
 [
  {
   "text": "Không ai mang *nhiệt*",
   "start": 0.36,
   "end": 1.202
  },
  {
   "text": "*kế* tới Mặt Trời,",
   "start": 1.202,
   "end": 2.313
  },
  {
   "text": "vậy sao biết",
   "start": 2.313,
   "end": 2.945
  },
  {
   "text": "*bề* *mặt* nó nóng",
   "start": 2.945,
   "end": 3.877
  },
  {
   "text": "khoảng *5.800* *độ*?",
   "start": 3.877,
   "end": 5.68
  }
 ],
 [
  {
   "text": "Nhưng bí mật nằm",
   "start": 0.33,
   "end": 1.383
  },
  {
   "text": "ở *màu* *sắc*:",
   "start": 1.383,
   "end": 2.753
  },
  {
   "text": "màu của vật nóng",
   "start": 2.753,
   "end": 3.807
  },
  {
   "text": "cho biết *nhiệt* *độ*.",
   "start": 3.807,
   "end": 4.98
  }
 ],
 [
  {
   "text": "Vậy chỉ cần",
   "start": 0.39,
   "end": 1.067
  },
  {
   "text": "*nhìn* *ánh* *sáng*,",
   "start": 1.067,
   "end": 1.744
  },
  {
   "text": "ta đọc được nhiệt",
   "start": 1.744,
   "end": 2.927
  },
  {
   "text": "độ *từ* *rất* *xa*.",
   "start": 2.927,
   "end": 3.95
  }
 ],
 [
  {
   "text": "Hãy nghĩ đến *thanh*",
   "start": 0.37,
   "end": 1.215
  },
  {
   "text": "*sắt* trong *lò* *rèn*.",
   "start": 1.215,
   "end": 2.18
  }
 ],
 [
  {
   "text": "Mới nung,",
   "start": 0.44,
   "end": 0.824
  },
  {
   "text": "nó *đỏ* *sẫm*,",
   "start": 0.824,
   "end": 1.601
  },
  {
   "text": "khoảng *700* *đến*",
   "start": 1.601,
   "end": 3.225
  },
  {
   "text": "*800* *độ* *C*.",
   "start": 3.225,
   "end": 4.69
  }
 ],
 [
  {
   "text": "Nung thêm,",
   "start": 0.4,
   "end": 0.805
  },
  {
   "text": "nó chuyển *màu* *cam*,",
   "start": 0.805,
   "end": 1.786
  },
  {
   "text": "khoảng *1.000* *độ* *C*.",
   "start": 1.786,
   "end": 3.99
  }
 ],
 [
  {
   "text": "Nóng hơn nữa,",
   "start": 0.3,
   "end": 0.893
  },
  {
   "text": "nó *sáng* *trắng*,",
   "start": 0.893,
   "end": 1.677
  },
  {
   "text": "từ khoảng *1.300* *độ*",
   "start": 1.677,
   "end": 3.687
  },
  {
   "text": "*C* trở lên.",
   "start": 3.687,
   "end": 4.4
  }
 ],
 [
  {
   "text": "Như vậy *càng* *nóng*,",
   "start": 0.4,
   "end": 1.553
  },
  {
   "text": "ánh sáng càng chuyển",
   "start": 1.553,
   "end": 2.857
  },
  {
   "text": "từ *đỏ* *sang* *trắng*.",
   "start": 2.857,
   "end": 3.96
  }
 ],
 [
  {
   "text": "Năm *1893*,",
   "start": 0.35,
   "end": 2.14
  },
  {
   "text": "nhà vật lý Đức",
   "start": 2.14,
   "end": 3.046
  },
  {
   "text": "*Wilhelm* *Wien* biến điều",
   "start": 3.046,
   "end": 4.275
  },
  {
   "text": "này thành *công* *thức*.",
   "start": 4.275,
   "end": 5.21
  }
 ],
 [
  {
   "text": "Rồi năm *1911*,",
   "start": 0.38,
   "end": 2.49
  },
  {
   "text": "ông nhận *giải* *Nobel*",
   "start": 2.49,
   "end": 3.49
  },
  {
   "text": "*Vật* *lý* cho",
   "start": 3.49,
   "end": 4.09
  },
  {
   "text": "các khám phá về",
   "start": 4.09,
   "end": 4.89
  },
  {
   "text": "*bức* *xạ* *nhiệt*.",
   "start": 4.89,
   "end": 5.61
  }
 ],
 [
  {
   "text": "Công thức ấy:",
   "start": 0.48,
   "end": 1.308
  },
  {
   "text": "*bước* *sóng* *màu* *sáng*",
   "start": 1.308,
   "end": 2.662
  },
  {
   "text": "*nhất* bằng *hằng* *số*",
   "start": 2.662,
   "end": 4.116
  },
  {
   "text": "chia cho *nhiệt* *độ*.",
   "start": 4.116,
   "end": 5.46
  }
 ],
 [
  {
   "text": "*Bước* *sóng* là",
   "start": 0.5,
   "end": 1.248
  },
  {
   "text": "độ dài một",
   "start": 1.248,
   "end": 1.996
  },
  {
   "text": "sóng ánh sáng,",
   "start": 1.996,
   "end": 2.744
  },
  {
   "text": "*mỗi* *màu* có một",
   "start": 2.744,
   "end": 4.152
  },
  {
   "text": "bước sóng riêng.",
   "start": 4.152,
   "end": 5.02
  }
 ],
 [
  {
   "text": "Bước sóng",
   "start": 0.42,
   "end": 1.136
  },
  {
   "text": "đo bằng *nano-mét*,",
   "start": 1.136,
   "end": 2.579
  },
  {
   "text": "*một* *phần* *triệu* *mi-li-mét*.",
   "start": 2.579,
   "end": 4.13
  }
 ],
 [
  {
   "text": "*Hằng* *số*",
   "start": 0.41,
   "end": 0.84
  },
  {
   "text": "ấy là *2.898.000*,",
   "start": 0.84,
   "end": 4.047
  },
  {
   "text": "tính theo nano-mét",
   "start": 4.047,
   "end": 4.691
  },
  {
   "text": "nhân độ *kelvin*.",
   "start": 4.691,
   "end": 5.92
  }
 ],
 [
  {
   "text": "*Kelvin* là thang nhiệt",
   "start": 0.47,
   "end": 1.543
  },
  {
   "text": "độ bắt đầu từ",
   "start": 1.543,
   "end": 2.402
  },
  {
   "text": "*độ* *không* *tuyệt* *đối*.",
   "start": 2.402,
   "end": 3.38
  }
 ],
 [
  {
   "text": "Muốn đổi từ độ",
   "start": 0.44,
   "end": 1.419
  },
  {
   "text": "C sang kelvin,",
   "start": 1.419,
   "end": 2.518
  },
  {
   "text": "chỉ cần",
   "start": 2.518,
   "end": 3.007
  },
  {
   "text": "*cộng* *khoảng* *273*.",
   "start": 3.007,
   "end": 4.84
  }
 ],
 [
  {
   "text": "Thử với *thanh* *sắt*",
   "start": 0.43,
   "end": 1.05
  },
  {
   "text": "*1.000* *độ* *C*.",
   "start": 1.05,
   "end": 2.51
  }
 ],
 [
  {
   "text": "Cộng 273,",
   "start": 0.4,
   "end": 2.041
  },
  {
   "text": "ra *1.273* *kelvin*.",
   "start": 2.041,
   "end": 3.91
  }
 ],
 [
  {
   "text": "Rồi lấy",
   "start": 0.26,
   "end": 0.742
  },
  {
   "text": "*2.898.000* *÷* *1.273*.",
   "start": 0.742,
   "end": 4.99
  }
 ],
 [
  {
   "text": "Ra khoảng *2.300* *nano-mét*.",
   "start": 0.42,
   "end": 2.58
  }
 ],
 [
  {
   "text": "Con số này",
   "start": 0.36,
   "end": 1.024
  },
  {
   "text": "*dài* *hơn* *nhiều* so",
   "start": 1.024,
   "end": 1.91
  },
  {
   "text": "với màu đỏ,",
   "start": 1.91,
   "end": 2.855
  },
  {
   "text": "nên sắt phát",
   "start": 2.855,
   "end": 3.52
  },
  {
   "text": "mạnh nhất ở vùng",
   "start": 3.52,
   "end": 4.536
  },
  {
   "text": "*mắt* *không* *thấy*.",
   "start": 4.536,
   "end": 5.32
  }
 ],
 [
  {
   "text": "Vì vậy mắt",
   "start": 0.47,
   "end": 1.277
  },
  {
   "text": "chỉ bắt được *phần*",
   "start": 1.277,
   "end": 2.179
  },
  {
   "text": "*đuôi* *màu* *đỏ*,",
   "start": 2.179,
   "end": 2.856
  },
  {
   "text": "và thanh sắt",
   "start": 2.856,
   "end": 3.983
  },
  {
   "text": "trông *đỏ* *rực*.",
   "start": 3.983,
   "end": 4.78
  }
 ],
 [
  {
   "text": "Giờ đến *Mặt* *Trời*:",
   "start": 0.41,
   "end": 2.027
  },
  {
   "text": "tách ánh sáng của",
   "start": 2.027,
   "end": 3.313
  },
  {
   "text": "nó *thành* *từng* *màu*.",
   "start": 3.313,
   "end": 4.62
  }
 ],
 [
  {
   "text": "Rồi xem *màu*",
   "start": 0.41,
   "end": 1.045
  },
  {
   "text": "*nào* *mạnh* *nhất*.",
   "start": 1.045,
   "end": 1.8
  }
 ],
 [
  {
   "text": "Kết quả,",
   "start": 0.26,
   "end": 0.682
  },
  {
   "text": "mạnh nhất ở",
   "start": 0.682,
   "end": 1.556
  },
  {
   "text": "khoảng *500* *nano-mét*,",
   "start": 1.556,
   "end": 3.145
  },
  {
   "text": "thuộc vùng *màu* *lục*.",
   "start": 3.145,
   "end": 4.45
  }
 ],
 [
  {
   "text": "Lấy *2.898.000* *÷* *500*.",
   "start": 0.46,
   "end": 3.61
  }
 ],
 [
  {
   "text": "Ra khoảng *5.800* *kelvin*.",
   "start": 0.34,
   "end": 2.34
  }
 ],
 [
  {
   "text": "Trừ khoảng 273,",
   "start": 0.32,
   "end": 2.029
  },
  {
   "text": "đó là khoảng",
   "start": 2.029,
   "end": 2.671
  },
  {
   "text": "*5.500* *độ* *C*.",
   "start": 2.671,
   "end": 4.59
  }
 ],
 [
  {
   "text": "Con số này",
   "start": 0.32,
   "end": 0.972
  },
  {
   "text": "gần với giá",
   "start": 0.972,
   "end": 1.623
  },
  {
   "text": "trị *NASA* ghi:",
   "start": 1.623,
   "end": 2.902
  },
  {
   "text": "*5.772* *kelvin*.",
   "start": 2.902,
   "end": 4.76
  }
 ],
 [
  {
   "text": "Bề mặt Mặt",
   "start": 0.35,
   "end": 1.022
  },
  {
   "text": "Trời *không* *có* *ranh*",
   "start": 1.022,
   "end": 1.918
  },
  {
   "text": "*giới* *rõ* *ràng*.",
   "start": 1.918,
   "end": 2.71
  }
 ],
 [
  {
   "text": "Nên sách ghi quanh",
   "start": 0.26,
   "end": 1.062
  },
  {
   "text": "*5.700* *đến* *6.000* *kelvin*.",
   "start": 1.062,
   "end": 4.3
  }
 ],
 [
  {
   "text": "Cũng nhờ cách ấy,",
   "start": 0.44,
   "end": 1.373
  },
  {
   "text": "đo được *nhiệt* *độ*",
   "start": 1.373,
   "end": 2.207
  },
  {
   "text": "*các* *ngôi* *sao* khác.",
   "start": 2.207,
   "end": 3.3
  }
 ],
 [
  {
   "text": "Sao *sáng* *nhất*",
   "start": 0.36,
   "end": 1.071
  },
  {
   "text": "*ở* *bước* *sóng*",
   "start": 1.071,
   "end": 1.782
  },
  {
   "text": "*ngắn* *hơn* thì *nóng*",
   "start": 1.782,
   "end": 2.929
  },
  {
   "text": "*hơn* Mặt Trời.",
   "start": 2.929,
   "end": 3.76
  }
 ],
 [
  {
   "text": "Vậy dù không",
   "start": 0.42,
   "end": 1.048
  },
  {
   "text": "ai chạm tới,",
   "start": 1.048,
   "end": 1.675
  },
  {
   "text": "*màu* *ánh* *sáng*",
   "start": 1.675,
   "end": 2.583
  },
  {
   "text": "cho biết bề",
   "start": 2.583,
   "end": 3.21
  },
  {
   "text": "mặt Mặt Trời nóng",
   "start": 3.21,
   "end": 4.277
  },
  {
   "text": "khoảng *5.800* *kelvin*.",
   "start": 4.277,
   "end": 6.58
  }
 ]
]