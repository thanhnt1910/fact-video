[
 [
  {
   "text": "Làm sao đo *thời*",
   "start": 0.54,
   "end": 1.281
  },
  {
   "text": "*gian* cho chuẩn,",
   "start": 1.281,
   "end": 1.837
  },
  {
   "text": "khi đồng hồ lò",
   "start": 1.837,
   "end": 2.917
  },
  {
   "text": "xo thời xưa",
   "start": 2.917,
   "end": 3.473
  },
  {
   "text": "chạy lệch tới *15*",
   "start": 3.473,
   "end": 4.684
  },
  {
   "text": "*phút* mỗi ngày?",
   "start": 4.684,
   "end": 5.36
  }
 ],
 [
  {
   "text": "Nhưng chỉ cần",
   "start": 0.4,
   "end": 0.994
  },
  {
   "text": "*một* *sợi* *dây* và",
   "start": 0.994,
   "end": 1.786
  },
  {
   "text": "*một* *quả* *nặng*,",
   "start": 1.786,
   "end": 2.38
  },
  {
   "text": "độ lệch ấy đã",
   "start": 2.38,
   "end": 3.522
  },
  {
   "text": "giảm đi *60* *lần*.",
   "start": 3.522,
   "end": 4.83
  }
 ],
 [
  {
   "text": "Hóa ra bí mật",
   "start": 0.43,
   "end": 1.312
  },
  {
   "text": "nằm ở một điều",
   "start": 1.312,
   "end": 2.194
  },
  {
   "text": "rất đơn giản:",
   "start": 2.194,
   "end": 3.266
  },
  {
   "text": "*quả* *lắc* đung đưa",
   "start": 3.266,
   "end": 4.148
  },
  {
   "text": "*đều* *như* *nhịp* *tim*.",
   "start": 4.148,
   "end": 5.15
  }
 ],
 [
  {
   "text": "Vậy vì sao",
   "start": 0.41,
   "end": 1.047
