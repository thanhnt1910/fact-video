  {
   "text": "quả lắc lại",
   "start": 1.047,
   "end": 1.683
  },
  {
   "text": "*đều* đến thế?",
   "start": 1.683,
   "end": 2.44
  }
 ],
 [
  {
   "text": "Nhà khoa học Ga-li-lê",
   "start": 0.44,
   "end": 1.258
  },
  {
   "text": "thấy rằng hai con",
   "start": 1.258,
   "end": 2.376
  },
  {
   "text": "lắc *dài* *bằng* *nhau*",
   "start": 2.376,
   "end": 3.195
  },
  {
   "text": "thì mỗi lần",
   "start": 3.195,
   "end": 4.068
  },
  {
   "text": "đung đưa mất *thời*",
   "start": 4.068,
   "end": 4.996
  },
  {
   "text": "*gian* *như* *nhau*.",
   "start": 4.996,
   "end": 5.73
  }
 ],
 [
  {
   "text": "Nghĩa là thời gian",
   "start": 0.47,
   "end": 1.289
  },
  {
   "text": "ấy chỉ phụ thuộc",
   "start": 1.289,
   "end": 2.108
  },
  {
   "text": "vào *độ* *dài* *dây*,",
   "start": 2.108,
   "end": 2.926
  },
  {
   "text": "không phụ",
   "start": 2.926,
   "end": 3.646
  },
  {
   "text": "thuộc *quả* *nặng*.",
   "start": 3.646,
   "end": 4.38
  }
 ],
 [
  {
   "text": "*Ví* *dụ*,",
   "start": 0.49,
   "end": 0.899
  },
  {
   "text": "trên xích đu,",
   "start": 0.899,
   "end": 1.651
  },
  {
   "text": "em bé hay người",
   "start": 1.651,
   "end": 2.879
  },
  {
   "text": "lớn đều mất *gần*",
   "start": 2.879,
   "end": 3.786
  },
  {
   "text": "*như* *cùng* *thời* *gian*",
   "start": 3.786,
   "end": 4.603
