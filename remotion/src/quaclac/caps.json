  {
   "text": "gian thật đều,",
   "start": 1.145,
   "end": 1.817
  },
  {
   "text": "hãy dựa vào",
   "start": 1.817,
   "end": 2.818
  },
  {
   "text": "*một* *thứ* *lặp*",
   "start": 2.818,
   "end": 3.49
  },
  {
   "text": "*lại* *đều* *đặn*,",
   "start": 3.49,
   "end": 4.161
  },
  {
   "text": "như quả",
   "start": 4.161,
   "end": 4.989
  },
  {
   "text": "lắc đung đưa.",
   "start": 4.989,
   "end": 5.78
  }
 ],
 [
  {
   "text": "Nhờ nó,",
   "start": 0.38,
   "end": 0.773
  },
  {
   "text": "mỗi ngày đồng hồ",
   "start": 0.773,
   "end": 1.809
  },
  {
   "text": "chỉ còn lệch",
   "start": 1.809,
   "end": 2.398
  },
  {
   "text": "khoảng *15* *giây* thay",
   "start": 2.398,
   "end": 3.847
  },
  {
   "text": "vì *15* *phút*.",
   "start": 3.847,
   "end": 4.95
  }
 ]
]