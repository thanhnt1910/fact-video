  {
   "text": "*thời* *gian* *một*",
   "start": 2.454,
   "end": 3.42
  },
  {
   "text": "*lượt* = *2*",
   "start": 3.42,
   "end": 4.276
  },
  {
   "text": "*×* *π* *×* *√(độ*",
   "start": 4.276,
   "end": 5.284
  },
  {
   "text": "*dài* *÷* *g)*.",
   "start": 5.284,
   "end": 6.16
  }
 ],
 [
  {
   "text": "Ở đây",
   "start": 0.4,
   "end": 0.77
  },
  {
   "text": "*π* khoảng *3,14*,",
   "start": 0.77,
   "end": 2.538
  },
  {
   "text": "còn *g* là",
   "start": 2.538,
   "end": 3.492
  },
  {
   "text": "số đo *lực* *hút*",
   "start": 3.492,
   "end": 4.232
  },
  {
   "text": "của Trái Đất,",
   "start": 4.232,
   "end": 5.106
  },
  {
   "text": "khoảng *9,8*.",
   "start": 5.106,
   "end": 6.15
  }
 ],
 [
  {
   "text": "Thử với sợi dây",
   "start": 0.35,
   "end": 1.321
  },
  {
   "text": "dài *1* *mét*.",
   "start": 1.321,
   "end": 2.17
  }
 ],
 [
  {
   "text": "*1* *÷*",
   "start": 0.38,
   "end": 0.906
  },
  {
   "text": "*9,8* ≈ *0,1*.",
   "start": 0.906,
   "end": 3.11
  }
 ],
 [
  {
   "text": "Lấy căn bậc",
   "start": 0.51,
   "end": 1.032
  },
  {
   "text": "hai của *0,1*,",
   "start": 1.032,
   "end": 2.167
  },
  {
   "text": "được khoảng *0,32*.",
   "start": 2.167,
   "end": 3.97
  }
 ],
 [
  {
   "text": "Rồi nhân với *2π*,",
   "start": 0.3,
   "end": 1.447
  },
  {
   "text": "tức khoảng *6,28*,",
   "start": 1.447,
   "end": 3.962
  },
  {
   "text": "ra khoảng *2* *giây*.",
   "start": 3.962,
   "end": 5.0
  }
 ],
 [
  {
   "text": "Vì thế quả lắc",
   "start": 0.38,
   "end": 1.119
  },
  {
   "text": "dài *gần* *1* *mét*",
   "start": 1.119,
   "end": 1.857
  },
  {
   "text": "cho nhịp tích tắc",
   "start": 1.857,
   "end": 2.946
  },
  {
   "text": "đúng *1* *giây*.",
   "start": 2.946,
   "end": 3.62
  }
 ],
 [
  {
   "text": "Vậy muốn đo thời",
   "start": 0.25,
   "end": 1.145
