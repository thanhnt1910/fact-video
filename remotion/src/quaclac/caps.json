  {
   "text": "= *900* giây.",
   "start": 2.635,
   "end": 4.2
  }
 ],
 [
  {
   "text": "Rồi *900* *÷* *15*",
   "start": 0.33,
   "end": 2.567
  },
  {
   "text": "= *60* lần.",
   "start": 2.567,
   "end": 3.92
  }
 ],
 [
  {
   "text": "Vậy đồng hồ quả",
   "start": 0.34,
   "end": 1.155
  },
  {
   "text": "lắc chính xác hơn",
   "start": 1.155,
   "end": 1.971
  },
  {
   "text": "khoảng *60* *lần*.",
   "start": 1.971,
   "end": 3.11
  }
 ],
 [
  {
   "text": "Công thức thật của",
   "start": 0.36,
   "end": 1.368
  },
  {
   "text": "quả lắc là:",
   "start": 1.368,
   "end": 2.454
