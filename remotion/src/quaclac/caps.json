  {
   "text": "cho mỗi lượt đưa.",
   "start": 4.603,
   "end": 5.64
  }
 ],
 [
  {
   "text": "Vậy muốn",
   "start": 0.38,
   "end": 0.8
  },
  {
   "text": "đo thời gian,",
   "start": 0.8,
   "end": 1.43
  },
  {
   "text": "ta chỉ cần *đếm*",
   "start": 1.43,
   "end": 2.5
  },
  {
   "text": "*số* *lần* đung đưa.",
   "start": 2.5,
   "end": 3.46
  }
 ],
 [
  {
   "text": "Năm *1657*,",
   "start": 0.46,
   "end": 2.393
  },
  {
   "text": "Hây-ghen được cấp",
   "start": 2.393,
   "end": 3.013
  },
  {
   "text": "bằng sáng chế",
   "start": 3.013,
   "end": 3.633
  },
  {
   "text": "cho *đồng* *hồ* *quả*",
   "start": 3.633,
   "end": 4.46
  },
  {
   "text": "*lắc* đầu tiên.",
   "start": 4.46,
   "end": 5.42
  }
 ],
 [
  {
   "text": "Ông đã làm",
   "start": 0.43,
   "end": 1.046
  },
  {
   "text": "xong mẫu từ *cuối*",
   "start": 1.046,
   "end": 1.867
  },
  {
   "text": "*năm* *trước* *đó*,",
   "start": 1.867,
   "end": 2.763
  },
  {
   "text": "để quả lắc",
   "start": 2.763,
   "end": 3.378
  },
  {
   "text": "*điều* *khiển* *nhịp*",
   "start": 3.378,
   "end": 3.994
  },
  {
   "text": "*chạy* của kim.",
   "start": 3.994,
   "end": 4.73
  }
 ],
 [
  {
   "text": "Nhờ vậy độ lệch",
   "start": 0.46,
   "end": 1.46
  },
  {
   "text": "giảm từ khoảng *15*",
   "start": 1.46,
   "end": 2.78
  },
  {
   "text": "*phút* xuống còn khoảng",
   "start": 2.78,
   "end": 3.76
  },
  {
   "text": "*15* *giây* mỗi ngày.",
   "start": 3.76,
   "end": 5.2
  }
 ],
 [
  {
   "text": "Ta tính thử:",
   "start": 0.25,
   "end": 0.749
  },
  {
   "text": "*15* *×* *60*",
   "start": 0.749,
   "end": 2.635
