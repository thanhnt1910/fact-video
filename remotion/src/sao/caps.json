   "text": "dài khoảng *3,26*",
   "start": 1.11,
   "end": 3.03
  },
  {
   "text": "năm ánh sáng.",
   "start": 3.03,
   "end": 3.78
  }
 ],
 [
  {
   "text": "Còn một năm ánh",
   "start": 0.42,
   "end": 1.249
  },
  {
   "text": "sáng là quãng",
   "start": 1.249,
   "end": 2.07
  },
  {
   "text": "đường ánh sáng đi",
   "start": 2.07,
   "end": 2.899
  },
  {
   "text": "trong *1* *năm*,",
   "start": 2.899,
   "end": 3.52
  },
  {
   "text": "gần *10*",
   "start": 3.52,
   "end": 4.779
  },
  {
   "text": "*nghìn* *tỉ* ki-lô-mét.",
   "start": 4.779,
   "end": 5.52
  }
 ],
 [
  {
   "text": "Với ngôi",
   "start": 0.42,
   "end": 0.861
  },
  {
   "text": "sao của Bét-xen:",
   "start": 0.861,
   "end": 1.522
  },
  {
   "text": "*1* *÷* *0,314* được",
   "start": 1.522,
   "end": 4.457
  },
  {
   "text": "khoảng *3,2* pác-xếch.",
   "start": 4.457,
   "end": 6.0
  }
 ],
 [
  {
   "text": "Rồi nhân với *3,26*,",
   "start": 0.36,
   "end": 2.642
  },
  {
   "text": "ra khoảng *10,4*",
   "start": 2.642,
   "end": 4.67
  },
  {
   "text": "năm ánh sáng.",
   "start": 4.67,
   "end": 5.55
  }
 ],
 [
  {
   "text": "Nghĩa là ánh",
   "start": 0.44,
   "end": 0.967
  },
  {
   "text": "sáng của ngôi sao",
   "start": 0.967,
   "end": 1.671
  },
  {
   "text": "ấy phải đi",
   "start": 1.671,
   "end": 2.198
  },
  {
   "text": "hơn *10* *năm* mới",
   "start": 2.198,
   "end": 3.253
  },
  {
   "text": "tới mắt ta.",
   "start": 3.253,
   "end": 3.9
  }
 ],
 [
  {
   "text": "Số đo ngày",
   "start": 0.31,
   "end": 0.958
  },
  {
   "text": "nay là khoảng *11,4*",
   "start": 0.958,
   "end": 2.902
  },
  {
   "text": "năm ánh sáng.",
   "start": 2.902,
   "end": 3.67
  }
 ],
 [
  {
   "text": "Vậy Bét-xen chỉ",
   "start": 0.38,
   "end": 1.077
  },
  {
   "text": "lệch chừng *1*",
   "start": 1.077,
   "end": 1.774
  },
  {
   "text": "*năm* ánh sáng,",
   "start": 1.774,
   "end": 2.561
  },
  {
   "text": "với dụng cụ thời",
   "start": 2.561,
   "end": 3.751
  },
  {
   "text": "ấy là rất giỏi.",
   "start": 3.751,
   "end": 4.8
  }
 ],
 [
  {
   "text": "Ngôi sao gần",
   "start": 0.48,
   "end": 1.124
  },
  {
   "text": "Mặt Trời nhất cũng",
   "start": 1.124,
   "end": 2.073
  },
  {
   "text": "nhảy rất ít,",
   "start": 2.073,
   "end": 2.907
  },
  {
   "text": "khoảng *0,77* giây góc.",
   "start": 2.907,
   "end": 4.96
  }
 ],
 [
  {
   "text": "Nó xa *4,24*",
   "start": 0.43,
   "end": 2.401
  },
  {
   "text": "năm ánh sáng.",
   "start": 2.401,
   "end": 3.26
  }
 ],
 [
  {
   "text": "Vậy là từ một",
   "start": 0.42,
   "end": 1.193
  },
  {
   "text": "cái nhảy nhỏ như",
   "start": 1.193,
   "end": 1.965
  },
  {
   "text": "*ngón* *tay* trước mắt,",
   "start": 1.965,
   "end": 2.738
  },
  {
   "text": "ta đo được",
   "start": 2.738,
   "end": 3.628
  },
  {
   "text": "cả *khoảng* *cách* tới",
   "start": 3.628,
   "end": 4.54
  },
  {
   "text": "các vì sao.",
   "start": 4.54,
   "end": 5.24
  }
 ]
]