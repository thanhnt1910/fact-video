[
 [
  {
   "text": "Đưa *1* *ngón* *tay*",
   "start": 0.35,
   "end": 1.167
  },
  {
   "text": "ra trước mặt,",
   "start": 1.167,
   "end": 2.15
  },
  {
   "text": "nhắm mắt này rồi",
   "start": 2.15,
   "end": 3.147
  },
  {
   "text": "đổi sang mắt kia:",
   "start": 3.147,
   "end": 4.384
  },
  {
   "text": "ngón tay như",
   "start": 4.384,
   "end": 4.997
  },
  {
   "text": "*nhảy* *sang* *bên*.",
   "start": 4.997,
   "end": 5.73
  }
 ],
 [
  {
   "text": "Làm sao một",
   "start": 0.36,
   "end": 0.926
  },
  {
   "text": "cái nhảy nhỏ như",
   "start": 0.926,
   "end": 1.682
  },
  {
   "text": "vậy lại cho",
   "start": 1.682,
   "end": 2.348
  },
  {
   "text": "biết ngôi sao ở",
   "start": 2.348,
   "end": 3.104
  },
  {
   "text": "*xa* *bao* *nhiêu*?",
   "start": 3.104,
   "end": 3.79
  }
 ],
 [
  {
   "text": "Nhưng sao ở",
   "start": 0.38,
   "end": 1.035
  },
  {
   "text": "xa hơn ngón",
   "start": 1.035,
   "end": 1.691
  },
  {
   "text": "tay rất nhiều,",
   "start": 1.691,
   "end": 2.346
  },
  {
   "text": "nên nó chỉ nhảy",
   "start": 2.346,
   "end": 3.52
  },
  {
   "text": "*một* *chút* *xíu*,",
   "start": 3.52,
   "end": 4.176
  },
  {
   "text": "mắt thường không thấy.",
   "start": 4.176,
   "end": 5.41
  }
 ],
 [
  {
   "text": "Vì sao",
   "start": 0.33,
   "end": 0.778
  },
  {
   "text": "ngón tay nhảy?",
   "start": 0.778,
   "end": 1.831
  },
  {
   "text": "Vì hai mắt",
   "start": 1.831,
   "end": 2.594
  },
  {
   "text": "đứng ở *2*",
   "start": 2.594,
   "end": 3.266
  },
  {
   "text": "*chỗ* khác nhau,",
   "start": 3.266,
   "end": 4.139
  },
  {
   "text": "cách nhau",
   "start": 4.139,
   "end": 4.587
  },
  {
   "text": "chừng *6* *cm*.",
   "start": 4.587,
   "end": 5.63
  }
 ],
 [
  {
   "text": "Nên vật càng *gần*",
   "start": 0.38,
   "end": 1.358
  },
  {
   "text": "thì nhảy càng nhiều,",
   "start": 1.358,
   "end": 2.316
  },
  {
   "text": "vật càng *xa* thì",
   "start": 2.316,
   "end": 3.694
  },
  {
   "text": "nhảy càng ít.",
   "start": 3.694,
   "end": 4.45
  }
 ],
 [
  {
   "text": "Vậy muốn thấy một",
   "start": 0.35,
   "end": 1.272
  },
  {
   "text": "ngôi sao nhảy,",
   "start": 1.272,
   "end": 1.964
  },
  {
   "text": "ta phải nhìn",
   "start": 1.964,
   "end": 3.046
  },
  {
   "text": "từ *2* *chỗ* cách",
   "start": 3.046,
   "end": 4.168
  },
  {
   "text": "nhau thật xa.",
   "start": 4.168,
   "end": 4.98
  }
 ],
 [
  {
   "text": "Trái Đất đi",
   "start": 0.39,
   "end": 1.047
  },
  {
   "text": "quanh Mặt Trời,",
   "start": 1.047,
   "end": 1.703
  },
  {
   "text": "nên *6* *tháng* sau",
   "start": 1.703,
   "end": 2.829
  },
  {
   "text": "ta đã ở phía",
   "start": 2.829,
   "end": 3.874
  },
  {
   "text": "bên kia quỹ đạo.",
   "start": 3.874,
   "end": 4.87
  }
 ],
 [
  {
   "text": "Khi ấy hai chỗ",
   "start": 0.31,
   "end": 1.099
  },
  {
   "text": "đứng cách nhau khoảng",
   "start": 1.099,
   "end": 1.889
  },
  {
   "text": "*300* *triệu* ki-lô-mét.",
   "start": 1.889,
   "end": 3.39
  }
 ],
 [
  {
   "text": "Năm *1838*,",
   "start": 0.36,
   "end": 2.242
  },
  {
   "text": "nhà thiên văn người",
   "start": 2.242,
   "end": 3.077
  },
  {
   "text": "Đức Bét-xen đã làm",
   "start": 3.077,
   "end": 3.913
  },
  {
   "text": "đúng như vậy.",
   "start": 3.913,
   "end": 4.66
  }
 ],
 [
  {
   "text": "Ông chọn một",
   "start": 0.34,
   "end": 1.044
  },
  {
   "text": "ngôi sao mờ trong",
   "start": 1.044,
   "end": 1.983
  },
  {
   "text": "chòm *Thiên* *Nga*,",
   "start": 1.983,
   "end": 2.688
  },
  {
   "text": "vì nó trôi *nhanh*",
   "start": 2.688,
   "end": 3.947
  },
  {
   "text": "*hơn* các sao khác",
   "start": 3.947,
   "end": 4.886
  },
  {
   "text": "ông từng xem.",
   "start": 4.886,
   "end": 5.81
  }
 ],
 [
  {
   "text": "Ông nghĩ sao",
   "start": 0.4,
   "end": 1.292
  },
  {
   "text": "trôi nhanh thì có",
   "start": 1.292,
   "end": 2.068
  },
  {
   "text": "thể ở *gần*,",
   "start": 2.068,
   "end": 2.78
  },
  {
   "text": "và gần thì",
   "start": 2.78,
   "end": 3.452
  },
  {
   "text": "cái nhảy mới đủ",
   "start": 3.452,
   "end": 4.228
  },
  {
   "text": "lớn để đo.",
   "start": 4.228,
   "end": 4.93
  }
 ],
 [
  {
   "text": "Từ đó ông đo",
   "start": 0.39,
   "end": 1.157
  },
  {
   "text": "được cái nhảy chỉ",
   "start": 1.157,
   "end": 1.923
  },
  {
   "text": "khoảng *0,314* giây góc.",
   "start": 1.923,
   "end": 3.96
  }
 ],
 [
  {
   "text": "Còn một giây",
   "start": 0.32,
   "end": 0.956
  },
  {
   "text": "góc là *1/3* *600*",
   "start": 0.956,
   "end": 3.304
  },
  {
   "text": "của một độ.",
   "start": 3.304,
   "end": 4.06
  }
 ],
 [
  {
   "text": "Ví dụ,",
   "start": 0.41,
   "end": 1.093
  },
  {
   "text": "một đồng xu",
   "start": 1.093,
   "end": 1.759
  },
  {
   "text": "rộng *2,5* *cm*,",
   "start": 1.759,
   "end": 3.479
  },
  {
   "text": "muốn nhìn",
   "start": 3.479,
   "end": 3.923
  },
  {
   "text": "nhỏ như thế,",
   "start": 3.923,
   "end": 4.848
  },
  {
   "text": "phải đặt",
   "start": 4.848,
   "end": 5.291
  },
  {
   "text": "xa *16* *km*.",
   "start": 5.291,
   "end": 6.68
  }
 ],
 [
  {
   "text": "Rồi có công",
   "start": 0.26,
   "end": 1.274
  },
  {
   "text": "thức rất gọn:",
   "start": 1.274,
   "end": 2.659
  },
  {
   "text": "*khoảng* *cách* (pác-xếch)",
   "start": 2.659,
   "end": 3.803
  },
  {
   "text": "= *1* *÷* *góc*",
   "start": 3.803,
   "end": 5.506
  },
  {
   "text": "*nhảy* (giây góc).",
   "start": 5.506,
   "end": 6.7
  }
 ],
 [
  {
   "text": "Cứ *1* *pác-xếch*",
   "start": 0.37,
   "end": 1.11
  },
