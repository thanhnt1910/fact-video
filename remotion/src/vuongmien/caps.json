[[{"text": "Vương miện *vàng* *ròng*", "start": 0.5, "end": 1.809}, {"text": "hay có trộn *bạc*?", "start": 1.809, "end": 3.459}, {"text": "Làm sao biết mà", "start": 3.459, "end": 5.538}, {"text": "*không* *phá* *nó*?", "start": 5.538, "end": 6.64}], [{"text": "Theo *giai* *thoại*,", "start": 0.41, "end": 2.092}, {"text": "lời giải đến ngay", "start": 2.092, "end": 4.198}, {"text": "*trong* *bồn* *tắm*.", "start": 4.198, "end": 5.62}], [{"text": "Vì sao *nước* *tràn*", "start": 0.37, "end": 1.593}, {"text": "lại cho biết *vàng*", "start": 1.593, "end": 2.817}, {"text": "*có* *bị* *pha* *bạc*?", "start": 2.817, "end": 4.16}], [{"text": "Vương miện *nặng* *đúng*", "start": 0.45, "end": 1.764}, {"text": "số vàng đã đưa,", "start": 1.764, "end": 3.078}, {"text": "nên *cân*", "start": 3.078, "end": 4.145}, {"text": "không thấy gì.", "start": 4.145, "end": 5.25}], [{"text": "Lấy bớt vàng,", "start": 0.38, "end": 1.465}, {"text": "thêm *bạc*", "start": 1.465, "end": 2.468}, {"text": "*cho* *đủ* *cân*,", "start": 2.468, "end": 3.553}, {"text": "thì cân *không* *đổi*.", "start": 3.553, "end": 5.46}], [{"text": "*Bạc* *nhẹ* *hơn* *vàng*:", "start": 0.41, "end": 1.49}, {"text": "cùng cân nặng,", "start": 1.49, "end": 2.56}, {"text": "bạc *chiếm*", "start": 2.56, "end": 3.43}, {"text": "*nhiều* *chỗ* *hơn*.", "start": 3.43, "end": 4.36}], [{"text": "Đo xem nó *chiếm*", "start": 0.32, "end": 1.711}, {"text": "*bao* *nhiêu* *chỗ*,", "start": 1.711, "end": 2.754}, {"text": "so với *vàng*", "start": 2.754, "end": 3.797}, {"text": "*ròng* cùng cân.", "start": 3.797, "end": 4.96}], [{"text": "Nhúng vào nước,", "start": 0.35, "end": 1.426}, {"text": "vật chiếm bao nhiêu", "start": 1.426, "end": 3.55}, {"text": "*chỗ* thì đẩy ra", "start": 3.55, "end": 5.524}, {"text": "bấy nhiêu *nước*.", "start": 5.524, "end": 6.72}], [{"text": "*Hai* *khối* cùng cân:", "start": 0.4, "end": 2.412}, {"text": "một *vàng*,", "start": 2.412, "end": 3.688}, {"text": "một *bạc*,", "start": 3.688, "end": 4.885}, {"text": "nhúng vào", "start": 4.885, "end": 5.891}, {"text": "*bình* *đầy* *nước*.", "start": 5.891, "end": 7.52}], [{"text": "Tràn *nhiều* *hơn*", "start": 0.34, "end": 1.613}, {"text": "khối vàng nghĩa", "start": 1.613, "end": 2.885}, {"text": "là có *bạc*:", "start": 2.885, "end": 4.738}, {"text": "*thợ* *gian* *lận*.", "start": 4.738, "end": 6.58}], [{"text": "*Khối* *lượng* *riêng*", "start": 0.35, "end": 1.634}, {"text": "(g mỗi cm³):", "start": 1.634, "end": 2.907}, {"text": "vàng *19,3*,", "start": 2.907, "end": 6.049}, {"text": "bạc *10,5*.", "start": 6.049, "end": 9.08}], [{"text": "*Thể* *tích* =", "start": 0.35, "end": 1.643}, {"text": "*khối* *lượng* ÷", "start": 1.643, "end": 2.897}, {"text": "*khối* *lượng* *riêng*.", "start": 2.897, "end": 4.29}], [{"text": "Ví dụ nặng", "start": 0.24, "end": 0.98}, {"text": "*1* *000* *g*,", "start": 0.98, "end": 2.473}, {"text": "vàng ròng:", "start": 2.473, "end": 3.32}, {"text": "1 000 ÷ 19,3", "start": 3.32, "end": 6.673}, {"text": "≈ *52* *cm³*.", "start": 6.673, "end": 7.86}], [{"text": "*Giả* *sử* 30% bạc:", "start": 0.47, "end": 1.937}, {"text": "700 ÷ 19,3 +", "start": 1.937, "end": 5.39}, {"text": "300 ÷ 10,5.", "start": 5.39, "end": 8.21}], [{"text": "≈ *65* *cm³*,", "start": 0.35, "end": 3.086}, {"text": "*lớn* *hơn* *13* *cm³*.", "start": 3.086, "end": 6.29}], [{"text": "*13* *ml* nước:", "start": 0.42, "end": 2.459}, {"text": "chậu rộng *20* *cm*,", "start": 2.459, "end": 5.727}, {"text": "nước chỉ", "start": 5.727, "end": 6.483}, {"text": "chênh *0,4* *mm*.", "start": 6.483, "end": 9.27}], [{"text": "*1586*:", "start": 0.26, "end": 3.822}, {"text": "Ga-li-lê gọi cách tràn", "start": 3.822, "end": 6.059}, {"text": "nước là *thô*.", "start": 6.059, "end": 7.7}], [{"text": "*Cân* *trong* *nước*:", "start": 0.4, "end": 1.765}, {"text": "vật nhẹ đi", "start": 1.765, "end": 3.33}, {"text": "đúng bằng *nước*", "start": 3.33, "end": 4.785}, {"text": "*nó* *đẩy* *ra*.", "start": 4.785, "end": 6.17}], [{"text": "Trong nước,", "start": 0.39, "end": 1.477}, {"text": "nó *nhẹ* *hơn* khối", "start": 1.477, "end": 3.65}, {"text": "vàng khoảng *13* *g*:", "start": 3.65, "end": 8.31}, {"text": "*cân* thấy được.", "start": 8.31, "end": 10.06}], [{"text": "Kim hoàn *cân* trong", "start": 0.34, "end": 2.109}, {"text": "*không* *khí* rồi trong", "start": 2.109, "end": 4.419}, {"text": "*nước* để biết đó", "start": 4.419, "end": 6.288}, {"text": "là *chất* *gì*.", "start": 6.288, "end": 7.66}], [{"text": "*Tàu* *sắt* vẫn nổi", "start": 0.46, "end": 1.911}, {"text": "vì thân rỗng", "start": 1.911, "end": 3.43}, {"text": "đẩy ra *nước* *nặng*", "start": 3.43, "end": 5.051}, {"text": "*bằng* *cả* *tàu*.", "start": 5.051, "end": 6.26}], [{"text": "Chuyện bồn tắm *chép*", "start": 0.34, "end": 2.091}, {"text": "*lại* *sau* *200* *năm*,", "start": 2.091, "end": 6.483}, {"text": "nhưng *ý* *khoa*", "start": 6.483, "end": 8.127}, {"text": "*học* vẫn đúng.", "start": 8.127, "end": 9.71}], []]